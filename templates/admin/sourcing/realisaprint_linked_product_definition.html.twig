{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Définition technique — ' ~ route.yoowiiProductCode %}
{% block sourcing_actions %}<a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_realisaprint_catalog_show', {id: catalog_product.id}) }}">Retour au produit fournisseur</a>{% endblock %}
{% block sourcing_content %}
<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Produit Yoowii</dt><dd class="col-sm-9"><code>{{ route.yoowiiProductCode }}</code></dd>
            <dt class="col-sm-3">Produit fournisseur</dt><dd class="col-sm-9"><code>{{ catalog_product.providerProductId }}</code></dd>
        </dl>
    </div>
</div>

{% if editable %}
    <div class="alert alert-info mt-4">Toute modification crée une nouvelle version de mapping inactive. Un nouveau contrôle de couverture et de prix sera requis.</div>
    {{ form_start(form, {attr: {class: 'card mt-4'}}) }}
        <div class="card-header"><h2 class="card-title">Modifier la définition liée</h2></div>
        <div class="card-body">
            {{ form_row(form.configuratorMode) }}
            {% if not prescript_available %}<div class="form-hint mb-3">Le mode Préscript sera proposé après synchronisation dès que ce stock sera déclaré compatible.</div>{% endif %}
            <details class="mb-3" open><summary>Configuration technique proposée (avancé)</summary><div class="mt-3">{{ form_row(form.options) }}</div></details>
            {{ form_row(form.pricingAxes) }}
            <button class="btn btn-primary">Enregistrer la définition</button>
        </div>
    {{ form_end(form) }}

<details class="card mt-4" open>
    <summary class="card-header">Configuration technique proposée (avancé)</summary>
    <div class="card-body">
        <h2 class="h3">Options du configurateur</h2>
        <pre class="mb-4 small">{{ definition.options|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
        <h2 class="h3">Axes de prix</h2>
        <pre class="mb-0 small">{{ definition.pricingAxes|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
    </div>
</details>

{% else %}
    <div class="alert alert-warning mt-4">Cette définition est publiée et ne peut pas être modifiée en place.</div>
    <details class="card mt-4" open>
        <summary class="card-header">Configuration technique proposée (avancé)</summary>
        <div class="card-body"><h2 class="h3">Options du configurateur</h2><pre class="mb-4 small">{{ definition.options|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre><h2 class="h3">Axes de prix</h2><pre class="mb-0 small">{{ definition.pricingAxes|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre></div>
    </details>
{% endif %}


{% endblock %}
