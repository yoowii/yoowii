{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Catalogue Realisaprint' %}
{% block sourcing_actions %}
<div class="d-flex flex-wrap align-items-center gap-2">
    <a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_sourcing_dashboard') }}">Retour Sourcing</a>
    <form method="post" action="{{ path('yoowii_admin_realisaprint_catalog_synchronize') }}"><input type="hidden" name="_token" value="{{ csrf_token('realisaprint_catalog_sync') }}"><button class="btn btn-primary">Synchroniser les produits</button></form>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#realisaprint-configuration-sync">Synchroniser les configurations de produit</button>
</div>
{% endblock %}
{% block sourcing_content %}
<div class="alert alert-info">Catalogue fournisseur en lecture seule. La synchronisation n’active ni produit Yoowii, ni route, ni mapping.</div>
{% if latest_sync_run %}
    {% set sync_summary = latest_sync_run.summary %}
    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center"><h2 class="card-title mb-0">Dernière synchronisation des configurations</h2><span class="badge text-white bg-{{ latest_sync_run.active ? 'primary' : (sync_summary.failed ? 'danger' : 'success') }}">{{ latest_sync_run.status.value }}</span></div>
        <p class="text-secondary mb-2">Mode {{ latest_sync_run.mode.value }} · créée le {{ latest_sync_run.createdAt|date('d/m/Y H:i') }}{% if latest_sync_run.finishedAt %} · terminée le {{ latest_sync_run.finishedAt|date('d/m/Y H:i') }}{% endif %}</p>
        <p class="mb-2">{{ sync_summary.synchronized }} synchronisé(s), {{ sync_summary.failed }} échec(s).</p>
        {% if latest_sync_run.report %}<details><summary>Voir le rapport ({{ sync_summary.selected }} produit(s))</summary><ul class="mb-0 mt-2">{% for entry in latest_sync_run.report %}<li><code>{{ entry.provider_product_id }}</code> — {{ entry.name }} : {{ entry.outcome }}{% if entry.detail is defined %} — {{ entry.detail }}{% endif %}</li>{% endfor %}</ul></details>{% endif %}
    </div></div>
{% endif %}
<div class="card"><div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Identifiant API</th><th>Produit Realisaprint</th><th>Préscript</th><th>API classique</th><th>Configuration</th><th>Vu le</th><th></th></tr></thead><tbody>
{% for product in products %}<tr class="{{ product.archived ? 'text-secondary' }}"><td><code>{{ product.providerProductId }}</code></td><td>{{ product.name }}</td><td>{{ product.prescriptStocks|length ? product.prescriptStocks|length ~ ' stock(s)' : '—' }}</td><td>{% if product.classicStockCount is null %}Non chargée{% elseif product.classicStockCount %}{{ product.classicStockCount }} stock(s){% else %}—{% endif %}</td><td>{{ product.configurationSyncedAt ? product.configurationSyncedAt|date('d/m/Y H:i') : 'Non chargée' }}</td><td>{{ product.lastSeenAt|date('d/m/Y H:i') }}</td><td class="text-end"><div class="btn-list justify-content-end">{% if product.classicStockCount is null %}<form method="post" action="{{ path('yoowii_admin_realisaprint_catalog_configuration_synchronize', {id: product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('realisaprint_catalog_configuration_' ~ product.id) }}"><button class="btn btn-sm btn-outline-primary">Charger</button></form>{% endif %}<a class="btn btn-sm btn-outline-primary" href="{{ path('yoowii_admin_realisaprint_catalog_show', {id: product.id}) }}">Consulter</a></div></td></tr>{% else %}<tr><td colspan="7" class="text-center text-secondary py-4">Aucun catalogue local. Lance la synchronisation.</td></tr>{% endfor %}
</tbody></table></div></div>
<div class="modal modal-blur fade" id="realisaprint-configuration-sync" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="{{ path('yoowii_admin_realisaprint_catalog_configurations_synchronize') }}"><input type="hidden" name="_token" value="{{ csrf_token('realisaprint_catalog_configurations_sync') }}"><div class="modal-header"><h2 class="modal-title">Synchroniser les configurations de produit</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button></div><div class="modal-body"><p>Les appels sont traités un par un et espacés de 17 secondes après chaque réponse.</p><label class="form-check"><input class="form-check-input" type="radio" name="mode" value="missing" checked><span class="form-check-label">Actualiser uniquement les produits sans configuration</span></label><label class="form-check mt-2"><input class="form-check-input" type="radio" name="mode" value="all"><span class="form-check-label">Actualiser tous les produits</span></label></div><div class="modal-footer"><button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Annuler</button><button type="submit" class="btn btn-primary">Lancer la synchronisation</button></div></form></div></div>
{% endblock %}
