{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Créer un brouillon Yoowii — ' ~ catalog_product.name %}
{% block sourcing_actions %}<a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_realisaprint_catalog_show', {id: catalog_product.id}) }}">Retour au produit fournisseur</a>{% endblock %}
{% block sourcing_content %}
<div class="row justify-content-center"><div class="col-xl-9 col-xxl-8">
<div class="alert alert-warning">Choisissez le stock et vérifiez le nom commercial. Les options et leurs correspondances fournisseur sont créées automatiquement ; le produit reste désactivé jusqu’au contrôle du prix et à sa publication.</div>
{{ form_start(form, {attr: {class: 'sourcing-form', 'data-controller': 'realisaprint-draft-identity realisaprint-draft-pictures', 'data-realisaprint-draft-identity-base-code-value': 'PRINT', 'data-realisaprint-draft-pictures-url-value': path('yoowii_admin_realisaprint_catalog_draft_pictures', {id: catalog_product.id}), 'data-realisaprint-draft-pictures-token-value': csrf_token('realisaprint_draft_pictures_' ~ catalog_product.id)}}) }}{{ form_errors(form) }}
<div class="card mb-4"><div class="card-header"><div><h2 class="card-title mb-1">Produit Yoowii</h2><div class="text-secondary small">Identité du brouillon qui sera créé.</div></div></div><div class="card-body"><div data-realisaprint-draft-identity-target="productCode">{% include 'admin/sourcing/_field.html.twig' with {field: form.productCode} only %}</div><div data-realisaprint-draft-identity-target="name">{% include 'admin/sourcing/_field.html.twig' with {field: form.name} only %}</div></div></div>
<div class="card mb-4"><div class="card-header"><div><h2 class="card-title mb-1">Catégorie Yoowii</h2><div class="text-secondary small">La catégorie détectée peut être remplacée avant la création.</div></div></div><div class="card-body">{% include 'admin/sourcing/_field.html.twig' with {field: form.taxon} only %}</div></div>
<div class="card mb-4"><div class="card-header"><div><h2 class="card-title mb-1">Configuration Realisaprint</h2><div class="text-secondary small">Sélectionnez le stock et le mode de configurateur.</div></div></div><div class="card-body"><div data-realisaprint-draft-identity-target="stock">{% include 'admin/sourcing/_field.html.twig' with {field: form.stock} only %}</div>{% include 'admin/sourcing/_field.html.twig' with {field: form.configuratorMode} only %}</div></div>
<div class="card mb-4" data-realisaprint-draft-pictures-target="section">
    <div class="card-header d-flex align-items-center"><div><h2 class="card-title mb-1">Image principale facultative</h2><div class="text-secondary small">Choisissez une seule source : une URL, un fichier importé ou un visuel Realisaprint.</div></div><button class="btn btn-outline-primary btn-sm ms-auto" type="button" data-action="realisaprint-draft-pictures#load">Charger les images Realisaprint</button></div>
    <div class="card-body"><div class="row"><div class="col-md-6">{{ form_label(form.pictureUrl) }}{{ form_widget(form.pictureUrl, {attr: {'data-realisaprint-draft-pictures-target': 'pictureUrl', 'data-action': 'input->realisaprint-draft-pictures#clearProviderChoice'}}) }}{{ form_help(form.pictureUrl) }}{{ form_errors(form.pictureUrl) }}</div><div class="col-md-6">{{ form_label(form.pictureFile) }}{{ form_widget(form.pictureFile, {attr: {'data-realisaprint-draft-pictures-target': 'pictureFile', 'data-action': 'change->realisaprint-draft-pictures#clearProviderChoice'}}) }}{{ form_help(form.pictureFile) }}{{ form_errors(form.pictureFile) }}</div></div><hr><p class="text-secondary mb-0" data-realisaprint-draft-pictures-target="status">Aucun visuel Realisaprint chargé.</p><div class="row row-cards mt-2" data-realisaprint-draft-pictures-target="results"></div>{{ form_widget(form.selectedPicture, {attr: {'data-realisaprint-draft-pictures-target': 'selected'}}) }}</div>
</div>
<details class="card mb-4"><summary class="card-header"><div><h2 class="card-title mb-1">Configuration avancée</h2><div class="text-secondary small">Options et axes de prix proposés au format JSON.</div></div></summary><div class="card-body">{% if shared_definition %}<div class="alert alert-warning d-flex align-items-center justify-content-between gap-3"><span>Une définition partagée existe déjà pour cette référence fournisseur. Restaurez ses valeurs si la configuration synchronisée a changé et que vous souhaitez conserver le même schéma.</span><button class="btn btn-outline-primary btn-sm flex-shrink-0" type="submit" name="restore_shared_definition" value="1">Rétablir les valeurs d’origine</button></div>{% endif %}{% include 'admin/sourcing/_field.html.twig' with {field: form.options} only %}{% include 'admin/sourcing/_field.html.twig' with {field: form.pricingAxes} only %}</div></details>
{% include 'admin/sourcing/_form_actions.html.twig' with {cancel_url: path('yoowii_admin_realisaprint_catalog_show', {id: catalog_product.id}), submit_label: 'Créer le brouillon'} only %}{{ form_rest(form) }}{{ form_end(form, {render_rest: false}) }}
</div></div>
{% endblock %}
