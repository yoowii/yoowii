{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Créer un brouillon Yoowii — ' ~ catalog_product.name %}
{% block sourcing_actions %}<a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_realisaprint_catalog_show', {id: catalog_product.id}) }}">Retour au produit fournisseur</a>{% endblock %}
{% block sourcing_content %}
<div class="row justify-content-center"><div class="col-xl-9 col-xxl-8">
<div class="alert alert-warning">Choisissez le stock et vérifiez le nom commercial. Les options et leurs correspondances fournisseur sont créées automatiquement ; le produit reste désactivé jusqu’au contrôle du prix et à sa publication.</div>
{{ form_start(form, {attr: {class: 'sourcing-form'}}) }}{{ form_errors(form) }}
<div class="card mb-4"><div class="card-header"><div><h2 class="card-title mb-1">Produit Yoowii</h2><div class="text-secondary small">Identité du brouillon qui sera créé.</div></div></div><div class="card-body">{% include 'admin/sourcing/_field.html.twig' with {field: form.productCode} only %}{% include 'admin/sourcing/_field.html.twig' with {field: form.name} only %}</div></div>
<div class="card mb-4"><div class="card-header"><div><h2 class="card-title mb-1">Configuration Realisaprint</h2><div class="text-secondary small">Sélectionnez le stock et le mode de configurateur.</div></div></div><div class="card-body">{% include 'admin/sourcing/_field.html.twig' with {field: form.stock} only %}{% include 'admin/sourcing/_field.html.twig' with {field: form.configuratorMode} only %}</div></div>
<details class="card mb-4"><summary class="card-header"><div><h2 class="card-title mb-1">Configuration avancée</h2><div class="text-secondary small">Options et axes de prix proposés au format JSON.</div></div></summary><div class="card-body">{% include 'admin/sourcing/_field.html.twig' with {field: form.options} only %}{% include 'admin/sourcing/_field.html.twig' with {field: form.pricingAxes} only %}</div></details>
{% include 'admin/sourcing/_form_actions.html.twig' with {cancel_url: path('yoowii_admin_realisaprint_catalog_show', {id: catalog_product.id}), submit_label: 'Créer le brouillon'} only %}{{ form_rest(form) }}{{ form_end(form, {render_rest: false}) }}
</div></div>
{% endblock %}
