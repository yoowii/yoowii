{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Contrôle avant publication — ' ~ mapping.yoowiiProductCode %}
{% block sourcing_actions %}<a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_sourcing_dashboard') }}">Retour sourcing</a>{% endblock %}
{% block sourcing_content %}
<div class="alert alert-info">
    Ce contrôle compare toutes les valeurs du configurateur au catalogue synchronisé, puis demande à Realisaprint
    le prix d'une seule configuration d'essai. Il ne teste pas toutes les combinaisons et n'actualise pas le catalogue.
</div>
<div class="alert alert-secondary">La couverture complète vérifie les correspondances du mapping ; elle ne prouve pas que toutes les combinaisons sont tarifables.</div>
{% if not route.isActive %}
    <a class="btn btn-outline-primary mb-3" href="{{ path('yoowii_admin_realisaprint_draft_repair', {routeId: route.id}) }}">Prévisualiser / corriger la définition du brouillon</a>
{% endif %}
<div class="card mb-4">
    <div class="card-header"><h2 class="card-title">Aperçu initial du configurateur</h2></div>
    <div class="card-body">
        <p class="text-secondary">Construit à partir des défauts publiés et des valeurs fixes. Cette action appelle seulement <code>show_variables</code> : elle ne lance ni <code>save_configuration</code> ni <code>get_price</code>.</p>
        {% if initial_display_state %}
            <dl class="row mb-3">
                <dt class="col-sm-4">Généré le</dt><dd class="col-sm-8">{{ initial_display_state.generated_at|default('') }}</dd>
                <dt class="col-sm-4">Configuration</dt><dd class="col-sm-8"><code>{{ initial_display_state.display_configuration|default({})|json_encode }}</code></dd>
                <dt class="col-sm-4">Champs masqués</dt><dd class="col-sm-8"><code>{{ initial_display_state.visibility|default({})|json_encode }}</code></dd>
                <dt class="col-sm-4">Valeurs disponibles</dt><dd class="col-sm-8"><code>{{ initial_display_state.availability|default({})|json_encode }}</code></dd>
            </dl>
            {% if initial_display_state.error is defined %}<div class="alert alert-warning">{{ initial_display_state.error }}</div>{% endif %}
            {% if initial_display_state.show_variables_response is defined and api_diagnostic_curl %}<button class="btn btn-outline-dark btn-sm mb-3" type="button" data-bs-toggle="modal" data-bs-target="#realisaprint-api-diagnostic">Voir l’appel API</button>{% endif %}
        {% else %}
            <p class="text-secondary">Aucun aperçu enregistré : le storefront affichera le formulaire statique publié.</p>
        {% endif %}
        <form method="post" action="{{ path('yoowii_admin_realisaprint_mapping_display_preview', {id: mapping.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('preview_realisaprint_mapping_' ~ mapping.id) }}">
            <button class="btn btn-outline-primary">Actualiser l’aperçu du configurateur</button>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header"><h2 class="card-title">Configuration envoyée pour le prix d'essai</h2></div>
    <div class="card-body">
        <p class="mb-2"><strong>Stock :</strong> {{ preview.stock }} — {{ preview.stock_label }}
            <span class="badge {{ preview.stock_valid ? 'bg-success-lt' : 'bg-danger-lt' }}">{{ preview.stock_valid ? 'Reconnu' : 'Invalide' }}</span>
        </p>
        <p class="text-secondary small mb-0">Chaque ligne permet de comparer les valeurs par défaut Yoowii et API, puis montre la valeur d'essai et son code envoyé à Realisaprint.</p>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Option Yoowii</th><th>Défaut Yoowii</th><th>Défaut API</th><th>Valeur d'essai</th><th>Correspondance Realisaprint</th><th>Couverture</th></tr></thead>
            <tbody>
            {% for row in preview.rows %}
                <tr>
                    <td><strong>{{ row.label }}</strong><br><small class="text-secondary">{{ row.option }}</small></td>
                    <td>{{ row.default }}{% if row.default_value %}<br><code>{{ row.default_value }}</code>{% endif %}</td>
                    <td>{{ row.provider_default }}{% if row.provider_default_value %}<br><code>{{ row.provider_default_value }}</code>{% endif %}</td>
                    <td>{{ row.sample }}</td>
                    <td><small>{{ row.provider_label ?: row.variable }}</small><br><code>{{ row.variable ?: 'Variable absente' }} = {{ row.provider_value }}</code></td>
                    <td><span class="badge {{ row.covered ? 'bg-success-lt' : 'bg-danger-lt' }}">{{ row.covered ? 'OK' : 'À corriger' }}</span>
                        <small class="text-secondary">{{ row.total > 0 ? row.mapped ~ '/' ~ row.total ~ ' valeurs' : 'Valeur libre' }}</small>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="card mt-4">
    <div class="card-header"><h2 class="card-title">Résultat du contrôle</h2></div>
    <div class="card-body">
        {% if validation %}
            <dl class="row">
                <dt class="col-sm-4">Contrôlé le</dt><dd class="col-sm-8">{{ validation.checkedAt|date('d/m/Y H:i') }}</dd>
                <dt class="col-sm-4">Couverture</dt><dd class="col-sm-8">{{ validation.coverageComplete and preview.covered ? 'Complète' : 'Incomplète' }}</dd>
                <dt class="col-sm-4">Cotation API</dt><dd class="col-sm-8">{{ validation.quotePassed ? 'Réussie' : 'Non validée' }}</dd>
                <dt class="col-sm-4">Valeurs effectivement testées</dt><dd class="col-sm-8"><code>{{ validation.testConfiguration|json_encode }}</code></dd>
                {% if validation.supplierCost is not null %}
                    <dt class="col-sm-4">Coût fournisseur de l'essai</dt><dd class="col-sm-8">{{ (validation.supplierCost / 100)|number_format(2, ',', ' ') }} EUR{% if validation.supplierBaseCost is not null and validation.supplierOptionsCost is not null %}<br><small class="text-secondary">Prix produit : {{ (validation.supplierBaseCost / 100)|number_format(2, ',', ' ') }} EUR + options : {{ (validation.supplierOptionsCost / 100)|number_format(2, ',', ' ') }} EUR</small>{% endif %}</dd>
                {% endif %}
            </dl>
            {% if not can_publish and validation.quotePassed and validation.coverageComplete %}
                <div class="alert alert-warning">Le contrôle a expiré ou le catalogue a changé. Relance-le avant la publication.</div>
            {% endif %}
            {% for error in validation.coverageErrors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
            {% if validation.technicalDetail %}
                <div class="alert alert-warning d-flex align-items-center gap-2">
                    {% if price_api_diagnostics is not empty %}<button class="btn btn-outline-dark btn-sm flex-shrink-0" type="button" data-bs-toggle="modal" data-bs-target="#realisaprint-price-api-diagnostic">Voir les appels de cotation</button>{% endif %}
                    <span>{{ validation.technicalDetail }}</span>
                </div>
            {% endif %}
        {% else %}
            <p class="text-secondary">Aucun contrôle API enregistré pour ce mapping. La table ci-dessus présente la configuration qui sera testée.</p>
        {% endif %}
        <div class="btn-list">
            <details class="w-100">
                <summary class="btn btn-outline-primary">Personnaliser les valeurs d’essai</summary>
                <form id="realisaprint-test-values" method="post" class="card card-body mt-3" action="{{ path('yoowii_admin_realisaprint_mapping_validate', {id: mapping.id}) }}">
                    <p class="text-secondary">Ces valeurs servent uniquement au contrôle API. Les valeurs fixes Realisaprint sont affichées mais restent imposées côté serveur.</p>
                    <div class="row">
                    {% for code, field in test_fields %}
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="test_{{ code }}">{{ field.label }}</label>
                            {% if not field.editable %}
                                <input class="form-control" id="test_{{ code }}" value="{{ sample[code]|default(field.fixed_label) }}" disabled>
                                <div class="form-hint">Valeur fixe Realisaprint.</div>
                            {% elseif field.choices is not empty %}
                                <select class="form-select" id="test_{{ code }}" name="test_values[{{ code }}]" required>
                                    {% for value, label in field.choices %}<option value="{{ value }}" {{ sample[code]|default('') == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
                                </select>
                            {% elseif field.type == 'integer' %}
                                <input class="form-control" id="test_{{ code }}" name="test_values[{{ code }}]" value="{{ sample[code]|default('') }}" type="number" step="1" required>
                            {% elseif field.type == 'float' %}
                                <input class="form-control" id="test_{{ code }}" name="test_values[{{ code }}]" value="{{ sample[code]|default('') }}" type="number" step="any" required>
                            {% else %}
                                <input class="form-control" id="test_{{ code }}" name="test_values[{{ code }}]" value="{{ sample[code]|default('') }}" type="text" required>
                            {% endif %}
                        </div>
                    {% endfor %}
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('validate_realisaprint_mapping_' ~ mapping.id) }}">
                </form>
            </details>
            <button class="btn btn-primary" type="submit" form="realisaprint-test-values">Lancer le contrôle du prix API</button>
            {% if can_publish %}
                <form method="post" action="{{ path('yoowii_admin_realisaprint_mapping_publish', {id: mapping.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('publish_realisaprint_mapping_' ~ mapping.id) }}">
                    <button class="btn btn-success">Activer le produit Yoowii</button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% if initial_display_state and initial_display_state.show_variables_response is defined and api_diagnostic_curl %}
    <div class="modal modal-blur fade" id="realisaprint-api-diagnostic" tabindex="-1" aria-labelledby="realisaprint-api-diagnostic-title" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="realisaprint-api-diagnostic-title">Diagnostic API Realisaprint</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary">Appel <code>show_variables</code> et réponse brute reçue lors du dernier aperçu. Les identifiants restent des variables d’environnement et ne sont jamais affichés.</p>
                    <h3 class="h4">Commande cURL</h3>
                    <pre class="bg-dark text-light p-3 rounded small"><code>{{ api_diagnostic_curl }}</code></pre>
                    <h3 class="h4">Données envoyées</h3>
                    <pre class="bg-dark text-light p-3 rounded small"><code>{{ initial_display_state.show_variables_request|default({})|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                    <h3 class="h4">Réponse</h3>
                    <pre class="bg-dark text-light p-3 rounded small mb-0"><code>{{ initial_display_state.show_variables_response|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                </div>
            </div>
        </div>
    </div>
{% endif %}
{% if price_api_diagnostics is not empty %}
    <div class="modal modal-blur fade" id="realisaprint-price-api-diagnostic" tabindex="-1" aria-labelledby="realisaprint-price-api-diagnostic-title" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
            <div class="modal-header"><h2 class="modal-title" id="realisaprint-price-api-diagnostic-title">Diagnostic de la cotation Realisaprint</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button></div>
            <div class="modal-body">
                <p class="text-secondary">Séquence réelle de la validation. Les valeurs d’essai sont transmises à <code>save_configuration</code> ; <code>get_price</code> utilise ensuite le code de cette configuration.</p>
                {% for call in price_api_diagnostics %}
                    <h3 class="h4">{{ loop.index }}. <code>{{ call.operation }}</code></h3>
                    <h4 class="h5">Commande cURL</h4><pre class="bg-dark text-light p-3 rounded small"><code>{{ call.curl }}</code></pre>
                    <h4 class="h5">Données envoyées</h4><pre class="bg-dark text-light p-3 rounded small"><code>{{ call.request|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                    <h4 class="h5">Réponse</h4><pre class="bg-dark text-light p-3 rounded small{{ loop.last ? ' mb-0' : '' }}"><code>{{ call.response|default(null)|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                {% endfor %}
            </div>
        </div></div>
    </div>
{% endif %}
{% endblock %}
