{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Validation avant publication — ' ~ mapping.yoowiiProductCode %}
{% block sourcing_actions %}<a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_sourcing_dashboard') }}">Retour sourcing</a>{% endblock %}
{% block sourcing_content %}
<div class="card"><div class="card-body">{% if validation %}<dl class="row"><dt class="col-sm-4">Contrôle</dt><dd class="col-sm-8">{{ validation.checkedAt|date('d/m/Y H:i') }}</dd><dt class="col-sm-4">Couverture</dt><dd class="col-sm-8">{{ validation.coverageComplete ? 'Complète' : 'Incomplète' }}</dd><dt class="col-sm-4">Cotation API</dt><dd class="col-sm-8">{{ validation.quotePassed ? 'Réussie' : 'Non validée' }}</dd>{% if validation.supplierCost is not null %}<dt class="col-sm-4">Coût fournisseur échantillon</dt><dd class="col-sm-8">{{ (validation.supplierCost / 100)|number_format(2, ',', ' ') }} EUR</dd>{% endif %}</dl>{% for error in validation.coverageErrors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}{% if validation.technicalDetail %}<div class="alert alert-warning">{{ validation.technicalDetail }}</div>{% endif %}{% else %}<p class="text-secondary">Aucune validation enregistrée.</p>{% endif %}<div class="btn-list"><form method="post" action="{{ path('yoowii_admin_realisaprint_mapping_validate', {id: mapping.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('validate_realisaprint_mapping_' ~ mapping.id) }}"><button class="btn btn-primary">Valider couverture et prix API</button></form>{% if validation and validation.coverageComplete and validation.quotePassed %}<form method="post" action="{{ path('yoowii_admin_realisaprint_mapping_publish', {id: mapping.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('publish_realisaprint_mapping_' ~ mapping.id) }}"><button class="btn btn-success">Publier de manière contrôlée</button></form>{% endif %}</div></div></div>
{% endblock %}
