{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Contrôle avant publication — ' ~ mapping.yoowiiProductCode %}
{% block sourcing_actions %}<a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_sourcing_dashboard') }}">Retour sourcing</a>{% endblock %}
{% block sourcing_content %}
<div class="alert alert-info">
    Ce contrôle compare toutes les valeurs du configurateur au catalogue synchronisé, puis demande à Realisaprint
    le prix d'une seule configuration d'essai. Il ne teste pas toutes les combinaisons et n'actualise pas le catalogue.
</div>
<div class="alert alert-secondary">La couverture complète vérifie les correspondances du mapping ; elle ne prouve pas que toutes les combinaisons sont tarifables.</div>
{% if not route.isActive %}
    <a class="btn btn-outline-primary mb-3" href="{{ path('yoowii_admin_realisaprint_draft_repair', {routeId: route.id}) }}">Prévisualiser / corriger la définition du brouillon</a>
{% endif %}
<div class="card">
    <div class="card-header"><h2 class="card-title">Configuration envoyée pour le prix d'essai</h2></div>
    <div class="card-body">
        <p class="mb-2"><strong>Stock :</strong> {{ preview.stock }} — {{ preview.stock_label }}
            <span class="badge {{ preview.stock_valid ? 'bg-success-lt' : 'bg-danger-lt' }}">{{ preview.stock_valid ? 'Reconnu' : 'Invalide' }}</span>
        </p>
        <p class="text-secondary small mb-0">Chaque ligne montre la valeur d'essai, son code envoyé à Realisaprint et la couverture de tous les choix de cette option.</p>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Option Yoowii</th><th>Valeur d'essai</th><th>Correspondance Realisaprint</th><th>Couverture</th></tr></thead>
            <tbody>
            {% for row in preview.rows %}
                <tr>
                    <td><strong>{{ row.label }}</strong><br><small class="text-secondary">{{ row.option }}</small></td>
                    <td>{{ row.sample }}</td>
                    <td><small>{{ row.provider_label ?: row.variable }}</small><br><code>{{ row.variable ?: 'Variable absente' }} = {{ row.provider_value }}</code></td>
                    <td><span class="badge {{ row.covered ? 'bg-success-lt' : 'bg-danger-lt' }}">{{ row.covered ? 'OK' : 'À corriger' }}</span>
                        <small class="text-secondary">{{ row.total > 0 ? row.mapped ~ '/' ~ row.total ~ ' valeurs' : 'Valeur libre' }}</small>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="card mt-4">
    <div class="card-header"><h2 class="card-title">Résultat du contrôle</h2></div>
    <div class="card-body">
        {% if validation %}
            <dl class="row">
                <dt class="col-sm-4">Contrôlé le</dt><dd class="col-sm-8">{{ validation.checkedAt|date('d/m/Y H:i') }}</dd>
                <dt class="col-sm-4">Couverture</dt><dd class="col-sm-8">{{ validation.coverageComplete and preview.covered ? 'Complète' : 'Incomplète' }}</dd>
                <dt class="col-sm-4">Cotation API</dt><dd class="col-sm-8">{{ validation.quotePassed ? 'Réussie' : 'Non validée' }}</dd>
                <dt class="col-sm-4">Valeurs effectivement testées</dt><dd class="col-sm-8"><code>{{ validation.testConfiguration|json_encode }}</code></dd>
                {% if validation.initialConfiguratorState %}<dt class="col-sm-4">État initial du configurateur</dt><dd class="col-sm-8"><code>{{ validation.initialConfiguratorState.state|json_encode }}</code></dd>{% endif %}
                {% if validation.supplierCost is not null %}
                    <dt class="col-sm-4">Coût fournisseur de l'essai</dt><dd class="col-sm-8">{{ (validation.supplierCost / 100)|number_format(2, ',', ' ') }} EUR{% if validation.supplierBaseCost is not null and validation.supplierOptionsCost is not null %}<br><small class="text-secondary">Prix produit : {{ (validation.supplierBaseCost / 100)|number_format(2, ',', ' ') }} EUR + options : {{ (validation.supplierOptionsCost / 100)|number_format(2, ',', ' ') }} EUR</small>{% endif %}</dd>
                {% endif %}
            </dl>
            {% if not can_publish and validation.quotePassed and validation.coverageComplete %}
                <div class="alert alert-warning">Le contrôle a expiré ou le catalogue a changé. Relance-le avant la publication.</div>
            {% endif %}
            {% for error in validation.coverageErrors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
            {% if validation.technicalDetail %}<div class="alert alert-warning">{{ validation.technicalDetail }}</div>{% endif %}
        {% else %}
            <p class="text-secondary">Aucun contrôle API enregistré pour ce mapping. La table ci-dessus présente la configuration qui sera testée.</p>
        {% endif %}
        <div class="btn-list">
            <details class="w-100">
                <summary class="btn btn-outline-primary">Personnaliser les valeurs d’essai</summary>
                <form id="realisaprint-test-values" method="post" class="card card-body mt-3" action="{{ path('yoowii_admin_realisaprint_mapping_validate', {id: mapping.id}) }}">
                    <p class="text-secondary">Ces valeurs servent uniquement au contrôle API. Les valeurs fixes Realisaprint sont affichées mais restent imposées côté serveur.</p>
                    <div class="row">
                    {% for code, field in test_fields %}
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="test_{{ code }}">{{ field.label }}</label>
                            {% if not field.editable %}
                                <input class="form-control" id="test_{{ code }}" value="{{ sample[code]|default(field.fixed_label) }}" disabled>
                                <div class="form-hint">Valeur fixe Realisaprint.</div>
                            {% elseif field.choices is not empty %}
                                <select class="form-select" id="test_{{ code }}" name="test_values[{{ code }}]" required>
                                    {% for value, label in field.choices %}<option value="{{ value }}" {{ sample[code]|default('') == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
                                </select>
                            {% elseif field.type == 'integer' %}
                                <input class="form-control" id="test_{{ code }}" name="test_values[{{ code }}]" value="{{ sample[code]|default('') }}" type="number" step="1" required>
                            {% elseif field.type == 'float' %}
                                <input class="form-control" id="test_{{ code }}" name="test_values[{{ code }}]" value="{{ sample[code]|default('') }}" type="number" step="any" required>
                            {% else %}
                                <input class="form-control" id="test_{{ code }}" name="test_values[{{ code }}]" value="{{ sample[code]|default('') }}" type="text" required>
                            {% endif %}
                        </div>
                    {% endfor %}
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('validate_realisaprint_mapping_' ~ mapping.id) }}">
                </form>
            </details>
            <button class="btn btn-primary" type="submit" form="realisaprint-test-values">Lancer le contrôle du prix API</button>
            {% if can_publish %}
                <form method="post" action="{{ path('yoowii_admin_realisaprint_mapping_publish', {id: mapping.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('publish_realisaprint_mapping_' ~ mapping.id) }}">
                    <button class="btn btn-success">Activer le produit Yoowii</button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
