{% extends 'admin/sourcing/base.html.twig' %}

{% set page_title = 'Sourcing print multi-fournisseurs' %}

{% block sourcing_actions %}
    <div class="btn-list">
        <a href="{{ path('yoowii_admin_sourcing_matrix_import') }}" class="btn btn-primary">Importer une matrice</a>
        <div class="dropdown">
            <button class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">Actions</button>
            <div class="dropdown-menu dropdown-menu-end">
                <a class="dropdown-item" href="{{ path('yoowii_admin_realisaprint_catalog') }}">Catalogue Realisaprint</a>
                <a class="dropdown-item" href="{{ path('yoowii_admin_sourcing_preview') }}">Prévisualiser un prix</a>
                <a class="dropdown-item" href="{{ path('yoowii_admin_sourcing_mapping_create') }}">Ajouter un mapping API</a>
            </div>
        </div>
    </div>
{% endblock %}

{% block sourcing_content %}
    <div class="nav nav-tabs mb-4" role="tablist">
        {% for key, label in {overview: 'Vue d’ensemble', products: 'Produits', suppliers: 'Fournisseurs', mappings: 'Mappings API', routes: 'Routage', matrices: 'Matrices tarifaires'} %}
            <a class="nav-link {{ section == key ? 'active' }}" href="{{ path('yoowii_admin_sourcing_dashboard', app.request.query.all|merge({section: key})) }}">{{ label }}</a>
        {% endfor %}
    </div>

    <div class="row row-cards mb-4">
        <div class="col-sm-6 col-lg-3">
            <a class="card card-sm card-link" href="{{ path('yoowii_admin_sourcing_dashboard', {section: 'suppliers'}) }}"><div class="card-body"><div class="h1 mb-0">{{ suppliers|length }}</div><div class="text-secondary">Fournisseurs</div></div></a>
        </div>
        <div class="col-sm-6 col-lg-3">
            <a class="card card-sm card-link" href="{{ path('yoowii_admin_sourcing_dashboard', {section: 'products'}) }}"><div class="card-body"><div class="h1 mb-0">{{ supplier_products|length }}</div><div class="text-secondary">Références</div></div></a>
        </div>
        <div class="col-sm-6 col-lg-3">
            <a class="card card-sm card-link" href="{{ path('yoowii_admin_sourcing_dashboard', {section: 'routes'}) }}"><div class="card-body"><div class="h1 mb-0">{{ routes|length }}</div><div class="text-secondary">Routes</div></div></a>
        </div>
        <div class="col-sm-6 col-lg-3">
            <a class="card card-sm card-link" href="{{ path('yoowii_admin_sourcing_dashboard', {section: 'matrices'}) }}"><div class="card-body"><div class="h1 mb-0">{{ matrices|length }}</div><div class="text-secondary">Versions tarifaires</div></div></a>
        </div>
    </div>

    {% if section == 'overview' %}
        {% set blocked = products|filter(product => product.health == 'blocked')|length %}
        <div class="alert {{ blocked ? 'alert-danger' : 'alert-info' }} d-flex justify-content-between align-items-center">
            <span><strong>{{ blocked }}</strong> produit{{ blocked > 1 ? 's' }} à corriger avant publication. Les recommandations n’empêchent pas la mise en vente.</span>
            <a class="btn btn-sm btn-outline-dark" href="{{ path('yoowii_admin_sourcing_dashboard', {section: 'products', health: 'blocked'}) }}">Voir les blocages</a>
        </div>
    {% endif %}

    {% if section == 'products' %}
        <form class="card card-body mb-4" method="get">
            <input type="hidden" name="section" value="products">
            <div class="row g-2 align-items-end">
                <div class="col-md-4"><label class="form-label" for="sourcing-q">Rechercher un produit</label><input id="sourcing-q" class="form-control" name="q" value="{{ query }}" placeholder="Code produit"></div>
                <div class="col-md-3"><label class="form-label" for="sourcing-supplier">Fournisseur</label><select id="sourcing-supplier" class="form-select" name="supplier"><option value="">Tous les fournisseurs</option>{% for supplier in suppliers %}<option value="{{ supplier.code }}" {{ supplier_filter == supplier.code ? 'selected' }}>{{ supplier.name }}</option>{% endfor %}</select></div>
                <div class="col-md-3"><label class="form-label" for="sourcing-health">Santé</label><select id="sourcing-health" class="form-select" name="health"><option value="">Tous les états</option><option value="blocked" {{ health_filter == 'blocked' ? 'selected' }}>Blocage</option><option value="attention" {{ health_filter == 'attention' ? 'selected' }}>À contrôler</option><option value="healthy" {{ health_filter == 'healthy' ? 'selected' }}>Sain</option></select></div>
                <div class="col-md-2"><button class="btn btn-primary w-100">Filtrer</button></div>
            </div>
            <label class="form-check mt-3"><input class="form-check-input" type="checkbox" name="inactive" value="1" {{ include_inactive ? 'checked' }}><span class="form-check-label">Afficher les inactifs</span></label>
        </form>
        <div class="card">
            <div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Produit</th><th>Fournisseur principal</th><th>Référence</th><th>Routage</th><th>Mapping</th><th>Tarification</th><th>Santé</th></tr></thead><tbody>
            {% for code, product in products %}
                {% set route = product.primary_route %}
                <tr><td><a href="{{ path('yoowii_admin_sourcing_product_show', {code: code}) }}"><strong>{{ product.name }}</strong><br><code class="text-secondary">{{ code }}</code></a></td><td>{{ route ? route.supplierProduct.supplier.name : '—' }}</td><td>{% if route %}<code>{{ route.supplierProduct.code }}</code>{% else %}—{% endif %}</td><td>{{ route ? 'Priorité ' ~ route.priority : '—' }}</td><td>{{ product.current_mappings|length ? 'Actif' : '—' }}</td><td>{{ product.current_matrices|length ? 'Active' : '—' }}</td><td><span class="badge {{ product.health == 'blocked' ? 'bg-danger-lt' : (product.health == 'attention' ? 'bg-warning-lt' : 'bg-success-lt') }}">{{ product.health == 'blocked' ? 'Blocage' : (product.health == 'attention' ? 'À contrôler' : 'Sain') }}</span>{% if product.errors|length %}<div class="small text-danger">{{ product.errors|first }}</div>{% elseif product.recommendations|length %}<div class="small text-secondary">{{ product.recommendations|first }}</div>{% endif %}</td></tr>
            {% else %}<tr><td colspan="7" class="text-center text-secondary py-4">Aucun produit sourcing ne correspond aux filtres.</td></tr>{% endfor %}
            </tbody></table></div>
        </div>
        {% if page_count > 1 %}<div class="d-flex justify-content-between align-items-center mt-3"><span class="text-secondary">{{ product_count }} produits</span><div class="btn-list"><a class="btn btn-outline-secondary {{ page == 1 ? 'disabled' }}" href="{{ path('yoowii_admin_sourcing_dashboard', app.request.query.all|merge({page: page - 1})) }}">Précédent</a><span class="btn btn-outline-secondary disabled">Page {{ page }} / {{ page_count }}</span><a class="btn btn-outline-secondary {{ page == page_count ? 'disabled' }}" href="{{ path('yoowii_admin_sourcing_dashboard', app.request.query.all|merge({page: page + 1})) }}">Suivant</a></div></div>{% endif %}
    {% endif %}

    {% if section == 'mappings' %}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="card-title">Mappings API versionnés</h2>
            <div class="btn-list">
                <a href="{{ path('yoowii_admin_sourcing_dashboard', mapping_history_visible ? {} : {history: 1}) }}" class="btn btn-sm btn-outline-secondary">{{ mapping_history_visible ? 'Masquer l’historique' : 'Voir l’historique' }}</a>
                <a href="{{ path('yoowii_admin_sourcing_mapping_create') }}" class="btn btn-sm btn-primary">Ajouter</a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Produit Yoowii</th><th>Fournisseur</th><th>Référence</th><th>Version</th><th>Applicable</th><th>État</th><th></th></tr></thead>
                <tbody>
                {% for mapping in mappings %}
                    <tr>
                        <td><code>{{ mapping.yoowiiProductCode }}</code></td>
                        <td>{{ mapping.supplierProduct.supplier.name }}</td>
                        <td><code>{{ mapping.supplierProduct.code }}</code></td>
                        <td>{{ mapping.version }}</td>
                        <td>{{ mapping.effectiveFrom|date('d/m/Y H:i') }}</td>
                        <td><span class="badge {{ mapping.isEffectiveAt(now) ? 'bg-success-lt' : 'bg-secondary-lt' }}">{{ mapping.isEffectiveAt(now) ? 'Actif' : 'Inactif' }}</span></td>
                        <td class="text-end">
                            {% if mapping.supplierProduct.supplier.code == 'realisaprint' %}
                                <a href="{{ path('yoowii_admin_realisaprint_mapping_validation', {id: mapping.id}) }}" class="btn btn-sm btn-outline-primary">Valider / publier</a>
                            {% endif %}
                            {% if mapping.isActive %}
                                <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#deactivate-mapping-{{ mapping.id }}">Désactiver</button>
                                <div class="modal modal-blur fade" id="deactivate-mapping-{{ mapping.id }}" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post" action="{{ path('yoowii_admin_sourcing_mapping_deactivate', {id: mapping.id}) }}"><div class="modal-header"><h2 class="modal-title">Désactiver ce mapping ?</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fermer"></button></div><div class="modal-body">Il ne sera plus applicable aux nouvelles cotations. Les commandes historiques ne sont pas modifiées.</div><div class="modal-footer"><input type="hidden" name="_token" value="{{ csrf_token('deactivate_mapping_' ~ mapping.id) }}"><button class="btn btn-link" type="button" data-bs-dismiss="modal">Annuler</button><button class="btn btn-danger" type="submit">Désactiver</button></div></form></div></div>
                            {% else %}
                                <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#delete-mapping-{{ mapping.id }}">Supprimer</button>
                                <div class="modal modal-blur fade" id="delete-mapping-{{ mapping.id }}" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post" action="{{ path('yoowii_admin_sourcing_mapping_delete', {id: mapping.id}) }}"><div class="modal-header"><h2 class="modal-title">Supprimer cette version ?</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fermer"></button></div><div class="modal-body">Cette suppression est définitive et n’est possible que si la version n’est ni publiée ni référencée.</div><div class="modal-footer"><input type="hidden" name="_token" value="{{ csrf_token('delete_mapping_' ~ mapping.id) }}"><button class="btn btn-link" type="button" data-bs-dismiss="modal">Annuler</button><button class="btn btn-danger" type="submit">Supprimer définitivement</button></div></form></div></div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-secondary py-4">Aucun mapping API configuré.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {% if section == 'suppliers' %}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="card-title">Fournisseurs</h2>
            <a href="{{ path('yoowii_admin_sourcing_supplier_create') }}" class="btn btn-sm btn-primary">Ajouter</a>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Code</th><th>Nom</th><th>Mode</th><th>Capacités</th><th>État</th><th></th></tr></thead>
                <tbody>
                {% for supplier in suppliers %}
                    <tr>
                        <td><code>{{ supplier.code }}</code></td>
                        <td>{{ supplier.name }}</td>
                        <td>{{ supplier.integrationMode.value }}</td>
                        <td>
                            {% for capability in supplier.capabilities %}<span class="badge bg-blue-lt me-1">{{ capability.value }}</span>{% else %}<span class="text-secondary">Manuel</span>{% endfor %}
                        </td>
                        <td><span class="badge {{ supplier.active ? 'bg-success-lt' : 'bg-secondary-lt' }}">{{ supplier.active ? 'Actif' : 'Inactif' }}</span></td>
                        <td class="text-end"><a href="{{ path('yoowii_admin_sourcing_supplier_edit', {id: supplier.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-secondary py-4">Aucun fournisseur configuré.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {% if section == 'suppliers' %}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="card-title">Références fournisseurs</h2>
            <a href="{{ path('yoowii_admin_sourcing_product_create') }}" class="btn btn-sm btn-primary">Ajouter</a>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Fournisseur</th><th>Code</th><th>Nom</th><th>État</th><th></th></tr></thead>
                <tbody>
                {% for product in supplier_products %}
                    <tr>
                        <td>{{ product.supplier.name }}</td>
                        <td><code>{{ product.code }}</code></td>
                        <td>{{ product.name }}</td>
                        <td><span class="badge {{ product.active ? 'bg-success-lt' : 'bg-secondary-lt' }}">{{ product.active ? 'Active' : 'Inactive' }}</span></td>
                        <td class="text-end"><a href="{{ path('yoowii_admin_sourcing_product_edit', {id: product.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-secondary py-4">Aucune référence fournisseur.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {% if section == 'routes' %}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="card-title">Routage principal et secours</h2>
            <a href="{{ path('yoowii_admin_sourcing_route_create') }}" class="btn btn-sm btn-primary">Ajouter une route</a>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Produit Yoowii</th><th>Priorité</th><th>Fournisseur</th><th>Référence</th><th>Période</th><th>État</th><th></th></tr></thead>
                <tbody>
                {% for route in routes %}
                    <tr>
                        <td><code>{{ route.yoowiiProductCode }}</code></td>
                        <td>{{ route.priority }}</td>
                        <td>{{ route.supplierProduct.supplier.name }}</td>
                        <td>{{ route.supplierProduct.code }}</td>
                        <td>{{ route.effectiveFrom|date('d/m/Y H:i') }} → {{ route.effectiveUntil ? route.effectiveUntil|date('d/m/Y H:i') : 'sans fin' }}</td>
                        <td><span class="badge {{ route.active ? 'bg-success-lt' : 'bg-secondary-lt' }}">{{ route.active ? 'Active' : 'Inactive' }}</span></td>
                        <td class="text-end">
                            {% if route.supplierProduct.supplier.code == 'realisaprint' %}
                                <a href="{{ path('yoowii_admin_realisaprint_mapping', {routeId: route.id}) }}" class="btn btn-sm btn-outline-primary">Mapping</a>
                            {% endif %}
                            <form method="post" action="{{ path('yoowii_admin_sourcing_route_toggle', {id: route.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_route_' ~ route.id) }}">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">{{ route.active ? 'Désactiver' : 'Activer' }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-secondary py-4">Aucune route configurée.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {% if section == 'matrices' %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="card-title">Matrices tarifaires</h2>
            <a href="{{ path('yoowii_admin_sourcing_matrix_import') }}" class="btn btn-sm btn-primary">Importer</a>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Produit</th><th>Fournisseur</th><th>Référence</th><th>Version</th><th>Devise</th><th>Applicable</th><th>État</th><th></th></tr></thead>
                <tbody>
                {% for matrix in matrices %}
                    <tr>
                        <td><code>{{ matrix.matrix.product_code|default('PRINT_FLYER (legacy)') }}</code></td>
                        <td>{{ matrix.supplierProduct.supplier.name }}</td>
                        <td>{{ matrix.supplierProduct.code }}</td>
                        <td>{{ matrix.version }}</td>
                        <td>{{ matrix.currencyCode }}</td>
                        <td>{{ matrix.effectiveFrom|date('d/m/Y H:i') }}</td>
                        <td><span class="badge bg-blue-lt">{{ matrix.status.value }}</span></td>
                        <td class="text-end">
                            <div class="btn-list flex-nowrap justify-content-end">
                                {% if matrix.status.value == 'draft' %}
                                    <form method="post" action="{{ path('yoowii_admin_sourcing_matrix_activate', {id: matrix.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('activate_matrix_' ~ matrix.id) }}">
                                        <button class="btn btn-sm btn-success" type="submit">Activer</button>
                                    </form>
                                {% endif %}
                                {% if matrix.status.value != 'archived' %}
                                    <button class="btn btn-sm btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#archive-matrix-{{ matrix.id }}">Archiver</button>
                                    <div class="modal modal-blur fade" id="archive-matrix-{{ matrix.id }}" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post" action="{{ path('yoowii_admin_sourcing_matrix_archive', {id: matrix.id}) }}"><div class="modal-header"><h2 class="modal-title">Archiver cette matrice ?</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fermer"></button></div><div class="modal-body">Une matrice archivée ne pourra jamais être réactivée. Les snapshots de commandes restent inchangés.</div><div class="modal-footer"><input type="hidden" name="_token" value="{{ csrf_token('archive_matrix_' ~ matrix.id) }}"><button class="btn btn-link" type="button" data-bs-dismiss="modal">Annuler</button><button class="btn btn-danger" type="submit">Archiver définitivement</button></div></form></div></div>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-center text-secondary py-4">Aucune matrice importée.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}
{% endblock %}
