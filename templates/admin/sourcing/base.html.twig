{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ page_title }} | Yoowii{% endblock %}

{% block body %}
    <div class="page">
        {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}

        <div class="page-wrapper">
            {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <div class="page-pretitle">Yoowii Commerce</div>
                            <h1 class="page-title">{{ page_title }}</h1>
                        </div>
                        <div class="col-auto ms-auto d-print-none">
                            {% block sourcing_actions %}{% endblock %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="page-body">
                <div class="container-xl">
                    {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            {% set is_realisaprint_diagnostic = type in ['realisaprint_test_success', 'realisaprint_test_error'] %}
                            <div class="alert alert-{{ type == 'realisaprint_test_error' or type == 'error' ? 'danger' : (type == 'realisaprint_test_success' ? 'success' : type) }} d-flex align-items-center gap-2" role="alert">
                                <span>{{ message }}</span>
                                {% if is_realisaprint_diagnostic %}
                                    <button class="btn btn-outline-dark btn-sm ms-auto flex-shrink-0" type="button" data-bs-toggle="modal" data-bs-target="#realisaprint-price-api-diagnostic">
                                        Voir les appels de cotation
                                    </button>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block sourcing_content %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
