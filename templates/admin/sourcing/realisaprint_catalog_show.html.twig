{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Realisaprint — ' ~ product.name %}
{% block sourcing_actions %}<a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_realisaprint_catalog') }}">Retour catalogue</a>{% endblock %}
{% block sourcing_content %}
<div class="card"><div class="card-body"><dl class="row"><dt class="col-sm-3">Produit API</dt><dd class="col-sm-9"><code>{{ product.providerProductId }}</code></dd><dt class="col-sm-3">Dernière configuration</dt><dd class="col-sm-9">{{ product.configurationSyncedAt ? product.configurationSyncedAt|date('d/m/Y H:i') : 'Jamais' }}</dd></dl>
<div class="btn-list"><form method="post" action="{{ path('yoowii_admin_realisaprint_catalog_configuration_synchronize', {id: product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('realisaprint_catalog_configuration_' ~ product.id) }}"><button class="btn btn-primary">Charger / actualiser la configuration</button></form>{% if product.configuration %}<a class="btn btn-outline-primary" href="{{ path('yoowii_admin_realisaprint_catalog_draft', {id: product.id}) }}">Créer un brouillon Yoowii</a>{% endif %}</div></div></div>
<div class="card mt-4"><div class="card-header"><h2 class="card-title">Produits Yoowii générés depuis ce produit</h2></div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Produit Yoowii</th><th>Stock Realisaprint</th><th>Statut Sylius</th><th>Mapping</th><th>Route fournisseur</th><th>Créé le</th><th></th></tr></thead><tbody>{% for item in generated_products %}<tr><td><a href="{{ path('sylius_admin_product_update', {id: item.product.id}) }}"><code>{{ item.product.code }}</code></a><br><span class="text-secondary small">{{ item.product.name }}</span></td><td>{{ item.stock }}</td><td><span class="badge {{ item.product.enabled ? 'bg-success-lt' : 'bg-secondary-lt' }}">{{ item.product.enabled ? 'Actif' : 'Brouillon / inactif' }}</span></td><td><span class="badge {{ item.mapping_status == 'actif' ? 'bg-success-lt' : (item.mapping_status == 'validé' ? 'bg-info-lt' : (item.mapping_status == 'brouillon' ? 'bg-warning-lt' : 'bg-secondary-lt')) }}">{{ item.mapping_status|capitalize }}</span></td><td><span class="badge {{ item.route_status == 'publiée' ? 'bg-success-lt' : 'bg-secondary-lt' }}">{{ item.route_status|capitalize }}</span></td><td>{{ item.product.createdAt|date('d/m/Y H:i') }}</td><td class="text-end"><div class="btn-list justify-content-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('sylius_admin_product_update', {id: item.product.id}) }}">Voir le produit Yoowii</a><a class="btn btn-sm btn-outline-primary" href="{{ path('yoowii_admin_realisaprint_mapping', {routeId: item.route.id}) }}">Reprendre le mapping</a>{% if item.mapping and item.mapping_status == 'validé' %}<form method="post" action="{{ path('yoowii_admin_realisaprint_mapping_publish', {id: item.mapping.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('publish_realisaprint_mapping_' ~ item.mapping.id) }}"><button class="btn btn-sm btn-success">Publier</button></form>{% endif %}</div></td></tr>{% else %}<tr><td colspan="7" class="text-center text-secondary py-4">Aucun produit Yoowii n’ encore été généré depuis ce produit fournisseur.</td></tr>{% endfor %}</tbody></table></div></div>
{% if product.configuration %}<div class="card mt-4"><div class="card-header"><h2 class="card-title">Stocks, variables et valeurs API</h2></div><div class="card-body"><pre class="mb-0 small">{{ product.configuration|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre></div></div>{% endif %}
{% endblock %}
