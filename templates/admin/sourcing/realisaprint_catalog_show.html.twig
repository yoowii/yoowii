{% extends 'admin/sourcing/base.html.twig' %}
{% set page_title = 'Realisaprint — ' ~ product.name %}
{% block sourcing_actions %}<a class="btn btn-outline-secondary" href="{{ path('yoowii_admin_realisaprint_catalog') }}">Retour catalogue</a>{% endblock %}
{% block sourcing_content %}
<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Produit fournisseur</dt><dd class="col-sm-9"><code>{{ product.providerProductId }}</code></dd>
            <dt class="col-sm-3">Configuration actualisée</dt><dd class="col-sm-9">{{ product.configurationSyncedAt ? product.configurationSyncedAt|date('d/m/Y H:i') : 'Jamais' }}</dd>
        </dl>
        <div class="btn-list">
            <form method="post" action="{{ path('yoowii_admin_realisaprint_catalog_configuration_synchronize', {id: product.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('realisaprint_catalog_configuration_' ~ product.id) }}">
                <button class="btn btn-outline-primary">Actualiser la configuration</button>
            </form>
            {% if product.configuration %}
                <a class="btn btn-primary" href="{{ path('yoowii_admin_realisaprint_catalog_draft', {id: product.id}) }}">Créer un produit Yoowii lié</a>
            {% endif %}
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header"><h2 class="card-title">Produits Yoowii liés</h2></div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Produit</th><th>Stock</th><th>État</th><th>Configuration</th><th>Actions</th></tr></thead>
            <tbody>
            {% for item in generated_products %}
                <tr>
                    <td><a href="{{ path('sylius_admin_product_update', {id: item.product.id}) }}">{{ item.product.name }}</a><br><code>{{ item.product.code }}</code></td>
                    <td>{{ item.stock }}</td>
                    <td><span class="badge {{ item.product.enabled ? 'bg-success-lt' : 'bg-secondary-lt' }}">{{ item.product.enabled ? 'Actif' : 'Brouillon' }}</span></td>
                    <td><span class="badge {{ item.configuration_status == 'Compatible' ? 'bg-success-lt' : 'bg-warning-lt' }}">{{ item.configuration_status }}</span></td>
                    <td>
                        <div class="btn-list">
                            {% if item.mapping %}
                                <form method="post" action="{{ path('yoowii_admin_realisaprint_mapping_validate', {id: item.mapping.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('validate_realisaprint_mapping_' ~ item.mapping.id) }}">
                                    <button class="btn btn-sm btn-outline-primary">Vérifier la configuration et le prix</button>
                                </form>
                                {% if item.configuration_status != 'Compatible' %}
                                    <a class="btn btn-sm btn-outline-warning" href="{{ path('yoowii_admin_realisaprint_mapping', {routeId: item.route.id}) }}">Corriger les correspondances</a>
                                {% endif %}
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-secondary py-4">Aucun produit Yoowii lié à cette référence.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% if product.configuration %}
    <details class="card mt-4">
        <summary class="card-header">Données fournisseur synchronisées (avancé)</summary>
        <div class="card-body"><pre class="mb-0 small">{{ product.configuration|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre></div>
    </details>
{% endif %}
{% endblock %}
