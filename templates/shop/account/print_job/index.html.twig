{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Mes impressions | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container py-5">
        <p class="text-uppercase text-primary fw-semibold mb-2">Yoowii Flow</p>
        <h1 class="display-6 mb-4">Mes impressions</h1>
        <div class="row g-3">
            {% for job in jobs %}
                <div class="col-12"><article class="card border-0 shadow-sm"><div class="card-body d-md-flex align-items-center justify-content-between gap-3 p-4">
                    <div><h2 class="h5 mb-1">{{ job.orderItem.productName }}</h2><p class="text-secondary mb-0">{{ job.reference }} · {{ job.orderItem.quantity }} exemplaire{{ job.orderItem.quantity > 1 ? 's' }}</p></div>
                    <div class="d-flex align-items-center gap-3"><span class="yoowii-print-status is-{{ job.status.value }}">{{ ('yoowii.print_flow.status.' ~ job.status.value)|trans }}</span><a class="btn btn-primary" href="{{ path('yoowii_shop_flow_print_job_show', {_locale: app.request.locale, reference: job.reference}) }}">Ouvrir le suivi</a></div>
                </div></article></div>
            {% else %}
                <div class="col-12"><div class="alert alert-info">Vous n’avez pas encore de dossier d’impression.</div></div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
