{% form_theme form '@SyliusShop/form/theme.html.twig' %}

{% set configurable_fields = [] %}
{% for field in form %}
    {% if field.vars.name != '_token' %}
        {% set configurable_fields = configurable_fields|merge([field]) %}
    {% endif %}
{% endfor %}
{% set initial_visibility = initial_provider_state.visibility|default({}) %}
{% set initial_availability = initial_provider_state.availability|default({}) %}
{% set configurator_controller = configurator_mode|default('') == 'matrix-print' ? 'matrix-print-configurator' : 'print-configurator' %}

<div
    class="yoowii-print-configurator"
    {% if available %}data-controller="{{ configurator_controller }}"{% endif %}
    data-yoowii-configurator-presentation="cards"
    data-{{ configurator_controller }}-refresh-url-value="{{ refresh_url|default('') }}"
    data-{{ configurator_controller }}-has-quote-value="{{ stored_quote and quote_token ? 'true' : 'false' }}"
    data-empty-quote-label="{{ 'yoowii.storefront.price_after_configuration'|trans }}"
    data-{{ configurator_controller }}-pricing-axes-value="{{ pricing_axes|default([])|json_encode|e('html_attr') }}"
    data-{{ configurator_controller }}-manual-quote-value="{{ manual_quote|default(false) ? 'true' : 'false' }}"
    data-{{ configurator_controller }}-debug-value="{{ app.environment == 'dev' ? 'true' : 'false' }}"
    {% if configurator_controller == 'matrix-print-configurator' %}
        data-matrix-print-configurator-matrix-combinations-value="{{ matrix_combinations|default([])|json_encode|e('html_attr') }}"
    {% endif %}
    {% if initial_provider_state is not null %}
        data-{{ configurator_controller }}-initial-provider-state-value="{{ initial_provider_state|json_encode|e('html_attr') }}"
    {% endif %}
    data-{{ configurator_controller }}-initial-provider-state-stale-value="{{ initial_provider_state_stale|default(false) ? 'true' : 'false' }}"
>
    <header class="mb-4 max-w-2xl">
        <h1 class="font-display text-3xl font-bold tracking-tight text-base-content sm:text-4xl">{{ product.name }}</h1>
        {% if product.shortDescription %}
            <div class="mt-3 max-w-3xl leading-relaxed text-base-content/75">{{ product.shortDescription }}</div>
        {% endif %}
    </header>

    {% if available %}
        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-8">
                <div
                    class="alert alert-danger d-none"
                    role="alert"
                    data-{{ configurator_controller }}-target="error"
                ></div>

                {{ form_start(form, {
                    attr: {
                        class: 'yoowii-print-options',
                        ('data-' ~ configurator_controller ~ '-target'): 'form',
                        'data-action': 'submit->' ~ configurator_controller ~ '#submit'
                    }
                }) }}
                {{ form_errors(form) }}

                {% for code, fixed in fixed_fields|default([]) %}
                    <p class="text-secondary mb-2" data-fixed-axis="{{ code }}">
                        <strong>{{ code|replace({'_': ' '})|capitalize }} :</strong> {{ fixed.label }} · valeur imposée par Realisaprint
                    </p>
                {% endfor %}
                {% set previous_steps_complete = true %}
                {% set secondary_started = false %}
                <h3 class="h5 mb-3">Caractéristiques</h3>
                {% for field in configurable_fields %}
                    {% set option_code = field.vars.name %}
                    {% if field.vars.attr['data-area']|default(1) == 2 and not secondary_started %}
                        {% set secondary_started = true %}
                        <h3 class="h5 mt-5 mb-3">Options complémentaires</h3>
                    {% endif %}
                    {% set step_index = loop.index0 %}
                    {% set initially_visible = initial_visibility[option_code] is defined ? initial_visibility[option_code] : true %}
                    {% set initially_available_values = initial_availability[option_code] is defined ? initial_availability[option_code] : null %}
                    {% set selected_label = null %}
                    {% for choice in field %}
                        {% if choice.vars.checked %}
                            {% set selected_label = choice.vars.label %}
                        {% endif %}
                    {% endfor %}
                    {% if selected_label is null and field.vars.value is not empty %}{% set selected_label = field.vars.value %}{% endif %}
                    {% set step_complete = selected_label is not null %}
                    {% set step_enabled = previous_steps_complete %}

                    <details
                        class="yoowii-print-step{{ step_complete ? ' is-complete' : '' }}{{ not step_enabled ? ' is-disabled' : '' }}{{ not initially_visible ? ' d-none' : '' }}"
                        data-{{ configurator_controller }}-target="step option"
                        data-step-index="{{ step_index }}"
                        data-option-code="{{ field.vars.name }}"
                        data-area="{{ field.vars.attr['data-area']|default(1) }}"
                        data-depends-on="{{ field.vars.attr['data-depends-on']|default('') }}"
                        aria-hidden="{{ initially_visible ? 'false' : 'true' }}"
                        {% if step_enabled and not step_complete %}open{% endif %}
                    >
                        <summary data-action="click->{{ configurator_controller }}#guardStep">
                            <span class="yoowii-print-step-status" aria-hidden="true">
                                <span class="yoowii-print-step-number">{{ loop.index }}</span>
                                <span class="yoowii-print-step-check">✓</span>
                            </span>
                            <span class="fw-semibold">{{ field.vars.label }}</span>
                            <span class="yoowii-print-step-value" data-role="step-value">
                                {{ selected_label ?? 'yoowii.storefront.choice_pending'|trans }}
                            </span>
                            <span class="yoowii-print-step-chevron" aria-hidden="true"></span>
                        </summary>

                        <div class="yoowii-print-step-content">
                            {{ form_errors(field) }}
                            {% if field|length > 0 %}<div class="yoowii-print-choice-grid{{ field.vars.name == 'format' ? ' is-format-grid' : '' }}">
                                {% for choice in field %}
                                    {% set initially_available = initially_available_values is null or choice.vars.value in initially_available_values %}
                                    <div class="yoowii-print-choice{{ not initially_available ? ' d-none' : '' }}">
                                        <label class="yoowii-print-choice-card" for="{{ choice.vars.id }}">
                                            {{ form_widget(choice, {
                                                label: false,
                                                disabled: not initially_visible,
                                                attr: {
                                                    class: 'btn-check',
                                                    autocomplete: 'off',
                                                    'data-action': 'change->' ~ configurator_controller ~ '#change',
                                                    'data-choice-label': choice.vars.label
                                                }
                                            }) }}
                                            {% if field.vars.name == 'format' %}
                                                <span class="yoowii-print-format-preview" aria-hidden="true">
                                                    <span>{{ choice.vars.value }}</span>
                                                </span>
                                            {% endif %}
                                            <span class="yoowii-print-choice-label">{{ choice.vars.label }}</span>
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                            {% else %}
                                {% set live_input = 'integer' in field.vars.block_prefixes or 'number' in field.vars.block_prefixes or 'text' in field.vars.block_prefixes %}
                                {{ form_widget(field, {disabled: not initially_visible, attr: {'data-action': live_input ? 'input->' ~ configurator_controller ~ '#input' : 'change->' ~ configurator_controller ~ '#change'}}) }}
                            {% endif %}
                        </div>
                    </details>

                    {% if not step_complete %}
                        {% set previous_steps_complete = false %}
                    {% endif %}
                {% endfor %}

                {{ form_rest(form) }}
                <noscript>
                    <button class="btn btn-primary btn-lg mt-3" type="submit">
                        {{ 'yoowii.storefront.calculate_price'|trans }}
                    </button>
                </noscript>
                {% if manual_quote|default(false) %}<button class="btn btn-primary btn-lg mt-3" type="button" data-action="{{ configurator_controller }}#calculate">
                    {{ 'yoowii.storefront.calculate_price'|trans }}
                </button>{% endif %}
                {{ form_end(form, {render_rest: false}) }}
            </div>

            <div class="col-12 col-lg-4">
                <aside class="card shadow-sm yoowii-print-summary">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="h4 mb-0">{{ 'yoowii.storefront.print_summary'|trans }}</h3>
                            <button
                                class="btn btn-link btn-sm p-0"
                                type="button"
                                data-action="{{ configurator_controller }}#reset"
                            >
                                {{ 'yoowii.storefront.restore_choices'|trans }}
                            </button>
                        </div>

                        <ul class="list-unstyled yoowii-print-summary-list mb-4">
                            {% for field in configurable_fields %}
                                {% set option_code = field.vars.name %}
                                {% set selected_label = null %}
                                {% for choice in field %}
                                    {% if choice.vars.checked %}
                                        {% set selected_label = choice.vars.label %}
                                    {% endif %}
                                {% endfor %}
                                <li
                                    class="{{ selected_label is not null ? 'is-complete' : 'is-pending' }}{{ initial_visibility[option_code] is defined and not initial_visibility[option_code] ? ' d-none' : '' }}"
                                    data-{{ configurator_controller }}-target="summaryItem"
                                    data-step-index="{{ loop.index0 }}"
                                    data-option-code="{{ option_code }}"
                                    data-pending-label="{{ 'yoowii.storefront.choice_pending'|trans }}"
                                    aria-hidden="{{ initial_visibility[option_code] is defined and not initial_visibility[option_code] ? 'true' : 'false' }}"
                                >
                                    <span class="yoowii-print-summary-check" aria-hidden="true">✓</span>
                                    <span class="yoowii-print-summary-name">{{ field.vars.label }}</span>
                                    <strong data-role="summary-value">
                                        {{ selected_label ?? 'yoowii.storefront.choice_pending'|trans }}
                                    </strong>
                                    <button
                                        class="btn btn-link btn-sm p-0"
                                        type="button"
                                        data-action="{{ configurator_controller }}#openStep"
                                        data-step-index="{{ loop.index0 }}"
                                    >
                                        {{ 'yoowii.storefront.change_choice'|trans }}
                                    </button>
                                </li>
                            {% endfor %}
                        </ul>

                        <div
                            class="yoowii-print-calculating d-none"
                            role="status"
                            aria-live="polite"
                            data-{{ configurator_controller }}-target="loading"
                        >
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span>{{ 'yoowii.storefront.calculating_price'|trans }}</span>
                        </div>

                        <div data-{{ configurator_controller }}-target="quoteResult">
                            {% include 'shop/product/show/_print_quote.html.twig' with {
                                pricing_snapshot: stored_quote ? stored_quote.pricingSnapshot : null,
                                quote_token: quote_token
                            } only %}
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    {% else %}
        <div class="alert alert-warning" role="alert">
            {{ 'yoowii.storefront.configuration_unavailable'|trans }}
        </div>
    {% endif %}
</div>
