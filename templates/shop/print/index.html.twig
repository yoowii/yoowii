{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}Produits imprimés | Yoowii{% endblock %}

{% block content %}
    <div class="container py-5">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="text-center mx-auto mb-5" style="max-width: 760px;">
            <p class="text-uppercase text-primary fw-semibold mb-2">Yoowii Print</p>
            <h1 class="display-5">Vos supports imprimés, configurés en ligne</h1>
            <p class="lead text-secondary">Choisissez un produit, sa finition et sa quantité. Yoowii calcule automatiquement le meilleur tarif disponible.</p>
        </div>

        <div class="row g-4 justify-content-center">
            {% for product_code in product_codes %}
                <div class="col-md-6 col-xl-5">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body p-4 p-xl-5">
                            <div class="text-primary fw-semibold mb-3">{{ product_code == 'PRINT_FLYER' ? 'Communication' : 'Identité professionnelle' }}</div>
                            <h2 class="h3">{{ product_code == 'PRINT_FLYER' ? 'Flyers personnalisés' : 'Cartes de visite' }}</h2>
                            <p class="text-secondary">{{ product_code == 'PRINT_FLYER' ? 'Formats, papiers, grammages et quantités adaptés à vos campagnes.' : 'Une présentation professionnelle avec plusieurs papiers, finitions et types de coins.' }}</p>
                            <a class="btn btn-primary mt-3" href="{{ path('yoowii_shop_print_configure', {productCode: product_code, _locale: app.request.locale}) }}">Configurer et calculer</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
