{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block body %}
    <div class="flex flex-col min-h-screen overflow-hidden">
        <div class="border-b border-base-300 bg-base-100 py-4">
            <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="flex gap-6 justify-between items-center">
                    {% hook 'sylius_shop.checkout.common.header' with {order} %}
                </div>
            </div>
        </div>
        <div class="relative">
            <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                {%- set is_complete = active_step == 'complete' -%}
                <div class="grid min-h-screen grid-cols-1 lg:grid-cols-12">
                    <div class="py-8{{ is_complete ? ' lg:col-start-2 lg:col-span-10' : ' lg:col-span-7 lg:pr-12' }}">
                        {% block content %}
                        {% endblock %}
                    </div>
                    {% block sidebar %}
                        {% if not is_complete %}
                            <aside class="relative py-8 lg:col-span-5 lg:pl-12">
                                {% hook 'sylius_shop.checkout.common.sidebar' with {order} %}
                                <div class="absolute inset-y-0 left-1/2 -z-10 w-screen -translate-x-1/2 bg-base-200 lg:left-0 lg:w-[50vw] lg:translate-x-0"></div>
                            </aside>
                        {% endif %}
                    {% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
