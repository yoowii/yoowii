{% import '@SyliusShop/shared/messages.html.twig' as messages %}

{% set resources = hookable_metadata.context.resources %}

{% if resources.data|length > 0 %}
    <div class="grid grid-cols-1 gap-x-5 gap-y-8 sm:grid-cols-2 xl:grid-cols-3" {{ sylius_test_html_attribute('products') }}>
        {% for product in resources.data %}
            {{ component('sylius_shop:product:card', {product: product, template: '@SyliusShop/product/common/card.html.twig'}) }}
        {% endfor %}
    </div>
{% else %}
    {{ messages.info('sylius.ui.no_results_to_display') }}
{% endif %}
