{% set form = hookable_metadata.context.form %}
{% set item = hookable_metadata.context.item %}
{% set is_print = item.variant.product.fulfillmentType.value|default('') == 'print' %}
<td class="min-w-24">
    {% if is_print %}
        <span class="text-sm text-base-content/60">—</span>
        <div class="hidden">{{ form_widget(form.quantity) }}</div>
    {% else %}
        {{ form_row(form.quantity, sylius_test_form_attribute('cart-item-quantity')|sylius_merge_recursive({label: false, attr: {class: 'input input-bordered w-full'}})) }}
    {% endif %}
</td>
