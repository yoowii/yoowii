<tbody>
    {% for index, form_item in hookable_metadata.context.form.items %}
        {% set item = form_item.vars.data %}
        <tr class="hover" {{ sylius_test_html_attribute('cart-item', index) }} {{ sylius_test_html_attribute('cart-item-product-row', item.productName) }}>
            {% hook 'body' with { form: form_item, item, index } %}
        </tr>
        {% set product = item.variant.product %}
        {% set snapshot = item.pricingSnapshot %}
        {% if product.fulfillmentType.value|default('') == 'print' and snapshot %}
            <tr class="bg-base-100" data-test-print-configuration-row>
                <td colspan="5" class="!pt-0 px-4 pb-4">
                    {% include 'shop/cart/index/content/form/sections/general/items/body/_print_details.html.twig' with { pricing_snapshot: snapshot } only %}
                </td>
            </tr>
        {% endif %}
    {% endfor %}
</tbody>
