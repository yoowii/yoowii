{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

{% set cart = hookable_metadata.context.cart %}

<div class="mb-2 flex items-center justify-between gap-2 text-sm">
    <div>{{ 'sylius.ui.items_total'|trans }}:</div>
    <div class="text-right" {{ sylius_test_html_attribute('cart-items-total') }}>{{ money.convertAndFormat(cart.getItemsSubtotal()) }}</div>
</div>
