{% set taxon = hookable_metadata.context.taxon %}
{% set loop = hookable_metadata.context.loop %}
<ul tabindex="{{ loop.index }}" class="dropdown-content menu z-[100] overflow-hidden p-1 max-lg:!static max-lg:!block max-lg:!scale-100 max-lg:!opacity-100 lg:top-full lg:left-1/2 lg:w-56 lg:-translate-x-1/2 lg:rounded-box lg:border lg:border-base-300 lg:bg-base-100 lg:shadow-md">
    {% for child_taxon in taxon.enabledChildren %}
        <li class="w-full">
            <a class="rounded-btn" href="{{ path('sylius_shop_product_index', {'slug': child_taxon.slug, '_locale': child_taxon.translation.locale}) }}" {{ sylius_test_html_attribute('menu-item', child_taxon.name) }}>
                {{ child_taxon.name }}
            </a>
        </li>
    {% endfor %}
</ul>
