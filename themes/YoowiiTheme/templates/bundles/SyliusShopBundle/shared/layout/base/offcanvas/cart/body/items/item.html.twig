{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

{% set item = hookable_metadata.context.item %}

<tr>
    <td>{{ component('sylius_shop:order_item:product_info', {item: item}) }}</td>
    <td>{{ item.quantity }}</td>
    <td class="text-right font-medium whitespace-nowrap">{{ money.convertAndFormat(item.unitPrice) }}</td>
</tr>
