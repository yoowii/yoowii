{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

{% set cart = hookable_metadata.context.cart %}

<div class="mt-auto">
    <div class="offcanvas-footer">
        <div class="flex justify-between border-t border-base-300 py-4">
            <div class="text-xl font-bold">{{ 'sylius.ui.subtotal'|trans }}:</div>
            <div class="text-xl font-bold text-right">{{ money.convertAndFormat(cart.itemsTotal) }}</div>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
            <div class="sm:w-1/2">
                <a href="{{ path('sylius_shop_cart_summary') }}" class="btn btn-secondary w-full" type="button">{{ 'sylius.ui.view_and_edit_cart'|trans }}</a>
            </div>
            <div class="sm:w-1/2">
                <a href="{{ path('sylius_shop_checkout_start') }}" class="btn btn-primary w-full" type="button">{{ 'sylius.ui.checkout'|trans }}</a>
            </div>
        </div>
    </div>
</div>
