{% set taxon = hookable_metadata.context.taxon %}
{% set loop = hookable_metadata.context.loop %}
{% from '@SyliusShop/shared/macro/icon.html.twig' import icon %}
<div tabindex="{{ loop.index }}" role="button" class="flex cursor-pointer items-center gap-1 rounded-btn px-3 py-2 font-medium transition-colors hover:bg-base-200 hover:text-primary">
    {{ taxon.name }}
    {{ icon('chevron-down', 'max-lg:!hidden') }}
</div>
