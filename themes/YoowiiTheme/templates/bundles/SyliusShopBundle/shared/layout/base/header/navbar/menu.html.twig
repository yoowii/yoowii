{% from '@SyliusShop/shared/macro/icon.html.twig' import icon %}
{% import 'shop/shared/header/mega_menu_family.html.twig' as mega_menu %}

{% set menu_taxons = taxons|default([]) %}
{% set main_navigation_taxons = yoowii_main_navigation_taxons() %}
{% do advanced_taxon_preload_menu(menu_taxons) %}
{% do yoowii_preload_mega_menu_products(menu_taxons) %}
{% set mega_menu_enabled = sylius.channel is defined and sylius.channel.hasMegaMenu %}
{% set channel_menu_taxon = sylius.channel is defined ? sylius.channel.menuTaxon : null %}
{% set catalogue_taxon = channel_menu_taxon ? channel_menu_taxon.root : null %}
{% set catalogue_url = catalogue_taxon ? path('sylius_shop_product_index', {'slug': catalogue_taxon.slug, '_locale': catalogue_taxon.translation.locale}) : path('sylius_shop_homepage') %}
{% set services = [
    {'label': 'yoowii.storefront.mega_menu.services.design', 'anchor': 'studio-de-design'},
    {'label': 'yoowii.storefront.mega_menu.services.file_check', 'anchor': 'controle-de-fichiers'},
    {'label': 'yoowii.storefront.mega_menu.services.file_adaptation', 'anchor': 'adaptation-de-fichiers'},
    {'label': 'yoowii.storefront.mega_menu.services.quote', 'anchor': 'devis-sur-demande'},
] %}

<div class="relative z-40 w-full bg-base-100" data-controller="mega-menu" data-action="keydown@window->mega-menu#closeOnEscape mouseleave->mega-menu#scheduleClose mouseenter->mega-menu#cancelClose focusout->mega-menu#closeOnFocusOut">
    <div class="hidden border-b border-base-300 xl:block">
        <nav class="yoowii-container" aria-label="{{ 'yoowii.storefront.mega_menu.navigation_label'|trans }}">
            <ul class="flex min-h-11 items-stretch gap-2 overflow-hidden py-2">
                <li class="flex-none">
                    {% if mega_menu_enabled %}
                        <button class="btn btn-primary inline-flex h-11 min-h-11 shrink-0 items-center justify-center whitespace-nowrap rounded-btn px-5 text-base font-bold shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-mega-menu-target="trigger" data-mega-menu-menu-id-param="all" data-action="click->mega-menu#toggle mouseenter->mega-menu#openFromTrigger focus->mega-menu#openFromTrigger" aria-expanded="false" aria-controls="yoowii-mega-menu-panel"><svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#menu"></use></svg>{{ 'yoowii.storefront.mega_menu.all_products'|trans }}</button>
                    {% else %}
                        <a class="btn btn-primary inline-flex h-11 min-h-11 shrink-0 items-center justify-center whitespace-nowrap rounded-btn px-5 text-base font-bold shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ catalogue_url }}"><svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#menu"></use></svg>{{ 'yoowii.storefront.mega_menu.all_products'|trans }}</a>
                    {% endif %}
                </li>
                {% for taxon in main_navigation_taxons %}
                    <li class="flex min-h-11 min-w-0 flex-1 items-center justify-center">
                        <a class="min-w-0 truncate px-2 text-center text-base font-semibold leading-5 text-base-content hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary 2xl:text-[1.0625rem]" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.locale}) }}" title="{{ taxon.name }}"{% if mega_menu_enabled and taxon.hasPanel %} data-mega-menu-menu-id-param="main-{{ taxon.id }}" data-action="mouseenter->mega-menu#openFromTrigger focus->mega-menu#openFromTrigger"{% endif %}>{{ taxon.name }}</a>
                        {% if mega_menu_enabled and taxon.hasPanel %}<button class="btn btn-ghost btn-xs btn-square shrink-0 text-base-content hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-mega-menu-target="trigger" data-mega-menu-menu-id-param="main-{{ taxon.id }}" data-action="click->mega-menu#toggle mouseenter->mega-menu#openFromTrigger focus->mega-menu#openFromTrigger" aria-label="{{ 'yoowii.storefront.mega_menu.open_family'|trans({'%family%': taxon.name}) }}" aria-expanded="false" aria-controls="yoowii-mega-menu-panel"><svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#chevron-down"></use></svg></button>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </div>

    {% if mega_menu_enabled %}
        <div class="fixed inset-x-0 bottom-0 z-10 top-[var(--header-h)] bg-neutral/50" hidden data-mega-menu-target="backdrop" data-action="click->mega-menu#close" aria-hidden="true"></div>
        <div id="yoowii-mega-menu-panel" class="absolute inset-x-0 top-full z-20 border-b border-base-300 bg-base-100 shadow-2xl" hidden data-mega-menu-target="panel">
            <div class="yoowii-container max-h-[calc(100dvh-var(--header-h))] overflow-y-auto py-7">
                <div class="grid grid-cols-[270px_minmax(0,1fr)_25%] gap-8">
                    <aside class="border-r border-base-300 pr-5" aria-label="{{ 'yoowii.storefront.mega_menu.families_label'|trans }}" data-mega-menu-target="familyNavigation">
                        <ul class="space-y-1">{% for taxon in menu_taxons %}<li><button class="flex w-full items-center justify-between gap-3 rounded-btn px-3 py-2.5 text-left text-base font-bold leading-6 text-base-content hover:bg-base-200 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary{% if loop.first %} bg-base-200 text-primary{% endif %}" type="button" data-mega-menu-target="family" data-mega-menu-family-id-param="{{ taxon.id }}" data-family-id="{{ taxon.id }}" data-action="click->mega-menu#activateFamily mouseenter->mega-menu#activateFamily focus->mega-menu#activateFamily"><span>{{ taxon.name }}</span><svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#chevron-right"></use></svg></button></li>{% endfor %}</ul>
                    </aside>

                    {% for taxon in menu_taxons %}
                        {% set mediaFeatured = taxon.images|filter(image => image.type|default('') == 'featured' and image.path|default('') is not empty) %}
                        <div class="contents" hidden data-mega-menu-target="familyPanel" data-family-id="{{ taxon.id }}" data-has-media-featured="{{ mediaFeatured is not empty ? 'true' : 'false' }}">
                            {{ mega_menu.groups(taxon) }}
                            {% if mediaFeatured is not empty %}
                                <aside class="min-w-0 overflow-hidden rounded-box bg-base-200">
                                    {% if mediaFeatured|length == 1 %}
                                        {% set media = mediaFeatured|first %}<img class="h-full min-h-[320px] w-full object-cover" src="{{ advanced_taxon_media_url(media.path) }}" alt="{{ media.title|default(taxon.name) }}" loading="lazy">
                                    {% else %}
                                        <div class="relative h-full min-h-[320px]">{% for media in mediaFeatured %}<figure{% if not loop.first %} hidden{% endif %} data-mega-menu-target="carouselSlide" data-carousel-id="family-{{ taxon.id }}"><img class="h-full min-h-[320px] w-full object-cover" src="{{ advanced_taxon_media_url(media.path) }}" alt="{{ media.title|default(taxon.name) }}" loading="lazy"></figure>{% endfor %}<div class="absolute inset-x-0 bottom-0 flex justify-between p-3"><button class="btn btn-circle btn-sm bg-base-100/90 text-base-content focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-mega-menu-carousel-id-param="family-{{ taxon.id }}" data-action="mega-menu#previousSlide" aria-label="{{ 'yoowii.storefront.mega_menu.previous_media'|trans }}"><svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#chevron-left"></use></svg></button><button class="btn btn-circle btn-sm bg-base-100/90 text-base-content focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-mega-menu-carousel-id-param="family-{{ taxon.id }}" data-action="mega-menu#nextSlide" aria-label="{{ 'yoowii.storefront.mega_menu.next_media'|trans }}"><svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#chevron-right"></use></svg></button></div></div>
                                    {% endif %}
                                </aside>
                            {% endif %}
                        </div>
                    {% endfor %}

                    {% for taxon in main_navigation_taxons %}
                        {% if taxon.hasPanel %}
                            <section class="col-span-3 min-w-0" hidden data-mega-menu-target="familyPanel" data-family-id="main-{{ taxon.id }}" data-has-media-featured="false">
                                <div class="grid grid-cols-[minmax(0,1fr)_25%] gap-8">
                                    <div class="min-w-0">
                                        <div class="flex items-start justify-between gap-4 border-b border-base-300 pb-4"><p class="font-display text-xl font-extrabold text-base-content">{{ taxon.name }}</p><a class="shrink-0 text-base font-bold leading-6 text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.locale}) }}">{{ 'yoowii.storefront.mega_menu.view_all_category'|trans }} <span aria-hidden="true">→</span></a></div>
                                        {% if taxon.children is not empty %}<ul class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">{% for child in taxon.children %}<li><a class="font-display font-extrabold text-base-content hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': child.slug, '_locale': child.locale}) }}">{{ child.name }}</a></li>{% endfor %}</ul>{% endif %}
                                        {% if taxon.products is not empty %}<ul class="mt-5 grid grid-cols-[repeat(auto-fill,minmax(160px,200px))] gap-3">{% for product in taxon.products %}{% set image = product.imagesByType('thumbnail').first ?: product.images.first %}<li class="w-full max-w-[200px]"><a class="group block overflow-hidden rounded-box border border-base-300 bg-base-100 hover:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': app.request.locale}) }}">{% if image and image.path %}<img class="aspect-[4/3] w-full object-cover" src="{{ image.path|imagine_filter('sylius_shop_product_thumbnail') }}" alt="" loading="lazy">{% else %}<span class="flex aspect-[4/3] items-center justify-center bg-base-200 text-primary"><svg class="size-7" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#category"></use></svg></span>{% endif %}<span class="block p-3 text-base font-bold leading-6 text-base-content group-hover:text-primary">{{ product.name }}</span></a></li>{% endfor %}</ul>{% if taxon.hasMoreProducts %}<a class="mt-4 inline-block text-base font-bold leading-6 text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.locale}) }}">{{ 'yoowii.storefront.mega_menu.view_all_products'|trans }} <span aria-hidden="true">→</span></a>{% endif %}{% endif %}
                                    </div>
                                    <aside class="yoowii-mega-menu-services min-h-[320px] rounded-box p-6"><span class="mb-6 flex size-12 items-center justify-center rounded-full bg-base-100 text-primary shadow-sm"><svg class="size-6" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#sparkle"></use></svg></span><p class="font-display text-xl font-extrabold text-base-content">{{ 'yoowii.storefront.mega_menu.services.title'|trans }}</p><ul class="mt-5 space-y-4 text-base font-bold leading-6">{% for service in services %}<li><a class="flex items-center justify-between gap-2 text-base-content hover:text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_contact_request') }}#{{ service.anchor }}"><span>{{ service.label|trans }}</span><span class="text-primary" aria-hidden="true">→</span></a></li>{% endfor %}</ul></aside>
                                </div>
                            </section>
                        {% endif %}
                    {% endfor %}

                    <aside class="yoowii-mega-menu-services min-h-[320px] rounded-box p-6" hidden data-mega-menu-target="servicePanel">
                        <span class="mb-6 flex size-12 items-center justify-center rounded-full bg-base-100 text-primary shadow-sm"><svg class="size-6" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#sparkle"></use></svg></span>
                        <p class="font-display text-xl font-extrabold text-base-content">{{ 'yoowii.storefront.mega_menu.services.title'|trans }}</p>
                        <ul class="mt-5 space-y-4 text-base font-bold leading-6">{% for service in services %}<li><a class="flex items-center justify-between gap-2 text-base-content hover:text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_contact_request') }}#{{ service.anchor }}"><span>{{ service.label|trans }}</span><span class="text-primary" aria-hidden="true">→</span></a></li>{% endfor %}</ul>
                    </aside>
                </div>
                <footer class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-base-300 pt-4 text-base leading-6"><a class="font-bold text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ catalogue_url }}">{{ 'yoowii.storefront.mega_menu.view_all_products'|trans }} <span aria-hidden="true">→</span></a><p class="font-bold text-base-content">{{ 'yoowii.storefront.mega_menu.need_help'|trans }} <a class="text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_contact_request') }}">{{ 'yoowii.storefront.mega_menu.contact_advice'|trans }} <span aria-hidden="true">→</span></a></p></footer>
            </div>
        </div>
    {% endif %}
</div>

<aside class="fixed inset-y-0 left-0 z-[70] w-[min(24rem,92vw)] -translate-x-full overflow-y-auto bg-base-100 p-5 text-base leading-6 shadow-2xl transition-transform peer-checked:translate-x-0 xl:hidden [&_.btn-sm]:text-base [&_.text-sm]:text-base" data-controller="mobile-menu" data-mobile-menu-checkbox-id-value="yoowii-nav-drawer" aria-label="{{ 'yoowii.storefront.mega_menu.mobile_navigation_label'|trans }}">
    <div data-mobile-menu-target="screen" data-mobile-menu-screen-id="root"><div class="mb-7 flex items-center justify-between"><p class="font-display text-xl font-extrabold text-base-content">{{ 'yoowii.storefront.mega_menu.all_products'|trans }}</p><button class="btn btn-ghost btn-sm btn-square focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-action="mobile-menu#close" aria-label="{{ 'yoowii.storefront.mega_menu.close'|trans }}"><svg class="size-5" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#close"></use></svg></button></div>{% if main_navigation_taxons is not empty %}<nav class="mb-6 border-b border-base-300 pb-5" aria-label="{{ 'yoowii.storefront.mega_menu.navigation_label'|trans }}"><p class="mb-2 text-sm font-bold text-base-content/70">{{ 'yoowii.storefront.mega_menu.quick_access'|trans }}</p><ul class="menu gap-2 text-base font-bold">{% for taxon in main_navigation_taxons %}<li>{% if taxon.hasPanel %}<button class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-action="mobile-menu#goTo" data-mobile-menu-screen-param="main-{{ taxon.id }}">{{ taxon.name }} <svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#chevron-right"></use></svg></button>{% else %}<a class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.locale}) }}">{{ taxon.name }}</a>{% endif %}</li>{% endfor %}</ul></nav>{% endif %}<nav aria-label="{{ 'yoowii.storefront.mega_menu.mobile_navigation_label'|trans }}"><ul class="menu gap-2 text-base font-bold">{% for taxon in menu_taxons %}{% set level2_taxons = advanced_taxon_ordered_children(taxon) %}<li>{% if level2_taxons is empty %}<a class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.translation.locale}) }}">{{ taxon.name }}</a>{% else %}<button class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-action="mobile-menu#goTo" data-mobile-menu-screen-param="family-{{ taxon.id }}">{{ taxon.name }} <svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#chevron-right"></use></svg></button>{% endif %}</li>{% endfor %}</ul></nav></div>
    {% for taxon in menu_taxons %}{% set level2_taxons = advanced_taxon_ordered_children(taxon) %}{% if level2_taxons is not empty %}<div hidden data-mobile-menu-target="screen" data-mobile-menu-screen-id="family-{{ taxon.id }}"><div class="mb-7 flex items-center justify-between"><button class="btn btn-ghost btn-sm -ml-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-action="mobile-menu#goTo" data-mobile-menu-screen-param="root"><svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#chevron-left"></use></svg>{{ 'yoowii.storefront.mega_menu.back'|trans }}</button><button class="btn btn-ghost btn-sm btn-square focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-action="mobile-menu#close" aria-label="{{ 'yoowii.storefront.mega_menu.close'|trans }}"><svg class="size-5" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#close"></use></svg></button></div><p class="font-display text-xl font-extrabold text-base-content">{{ taxon.name }}</p><a class="mt-2 inline-block text-sm font-bold text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.translation.locale}) }}">{{ 'yoowii.storefront.mega_menu.view_all_category'|trans }} <span aria-hidden="true">→</span></a><ul class="menu mt-6 gap-2 text-base font-bold">{% for group_taxon in level2_taxons %}<li><a class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': group_taxon.slug, '_locale': group_taxon.translation.locale}) }}">{{ group_taxon.name }}</a></li>{% endfor %}</ul></div>{% endif %}{% endfor %}
    {% for taxon in main_navigation_taxons %}{% if taxon.hasPanel %}<div hidden data-mobile-menu-target="screen" data-mobile-menu-screen-id="main-{{ taxon.id }}"><div class="mb-7 flex items-center justify-between"><button class="btn btn-ghost btn-sm -ml-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-action="mobile-menu#goTo" data-mobile-menu-screen-param="root"><svg class="size-4" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#chevron-left"></use></svg>{{ 'yoowii.storefront.mega_menu.back'|trans }}</button><button class="btn btn-ghost btn-sm btn-square focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" type="button" data-action="mobile-menu#close" aria-label="{{ 'yoowii.storefront.mega_menu.close'|trans }}"><svg class="size-5" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#close"></use></svg></button></div><p class="font-display text-xl font-extrabold text-base-content">{{ taxon.name }}</p><a class="mt-2 inline-block text-sm font-bold text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.locale}) }}">{{ 'yoowii.storefront.mega_menu.view_all_category'|trans }} <span aria-hidden="true">→</span></a><ul class="menu mt-6 gap-2 text-base font-bold">{% for child in taxon.children %}<li><a class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': child.slug, '_locale': child.locale}) }}">{{ child.name }}</a></li>{% endfor %}{% for product in taxon.products %}<li><a class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': app.request.locale}) }}">{{ product.name }}</a></li>{% endfor %}</ul>{% if taxon.hasMoreProducts %}<a class="mt-5 inline-block text-sm font-bold text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.locale}) }}">{{ 'yoowii.storefront.mega_menu.view_all_products'|trans }} <span aria-hidden="true">→</span></a>{% endif %}</div>{% endif %}{% endfor %}
</aside>
<button class="fixed inset-0 z-[60] hidden bg-neutral/45 peer-checked:block xl:hidden" type="button" data-controller="mobile-menu" data-mobile-menu-checkbox-id-value="yoowii-nav-drawer" data-action="mobile-menu#close" aria-label="{{ 'yoowii.storefront.mega_menu.close'|trans }}"></button>
