{% set address = hookable_metadata.context.address %}

<article class="min-w-0 rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
    <div {{ sylius_test_html_attribute('address', "%s %s"|format(address.firstName, address.lastName)) }}>
        {% hook 'address' with { address, customer: address.customer } %}
    </div>
</article>
