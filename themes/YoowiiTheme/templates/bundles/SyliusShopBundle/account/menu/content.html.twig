{% extends 'knp_menu.html.twig' %}

{% block root %}
    <div class="mb-3 px-3 text-sm font-semibold uppercase tracking-wide text-base-content/60">{{ item.label|trans }}</div>
    {{ block('list') }}
{% endblock %}

{% block list %}
    <div class="menu rounded-box border border-base-300 bg-base-100 p-2 shadow-sm">
        {% for item in item.children %}
            {{ block('item') }}
        {% endfor %}
    </div>
{% endblock %}

{% block item %}
    <a class="flex items-center gap-2 rounded-btn px-3 py-2 transition-colors hover:bg-base-200 hover:text-primary" href="{{ item.uri }}">
        {{ ux_icon(item.labelAttributes.icon, {'class': 'size-5'}) }}
        {{ item.label|trans }}
    </a>
{% endblock %}
