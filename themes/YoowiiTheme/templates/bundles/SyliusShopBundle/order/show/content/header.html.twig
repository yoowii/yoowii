{% import "@SyliusShop/shared/macro/money.html.twig" as money %}
{% set order = hookable_metadata.context.order %}

<div class="mb-6 rounded-box border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
    <h1 class="text-2xl font-bold tracking-tight">{{ 'sylius.ui.summary_of_your_order'|trans }} #{{ order.number }}</h1>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-base-content/65">
        {{ order.checkoutCompletedAt|date }}
        {{ money.convertAndFormat(order.total) }}
        {{ order.totalQuantity }} {{ 'sylius.ui.items'|trans|lower }}
    </div>
</div>
