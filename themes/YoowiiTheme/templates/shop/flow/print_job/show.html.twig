{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'yoowii.print_flow.job_title'|trans({'%reference%': job.reference}) }} | {{ parent() }}{% endblock %}

{% block content %}
    {% set item = job.orderItem %}
    {% set steps = ['awaiting_files', 'files_received', 'bat_pending', 'bat_ready', 'bat_approved', 'in_production', 'shipped', 'delivered'] %}
    {% set current_step = -1 %}
    {% for step in steps %}
        {% if step == job.status.value %}{% set current_step = loop.index0 %}{% endif %}
    {% endfor %}

    <div class="yoowii-print-flow mx-auto my-8 w-full max-w-7xl px-4 sm:px-6 lg:my-12 lg:px-8">
        <div class="grid min-w-0 grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-8">
            <main class="min-w-0">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        {% set flash_class = type in ['error', 'danger'] ? 'alert-error' : (type in ['success', 'warning', 'info'] ? 'alert-' ~ type : 'alert-info') %}
                        <div class="alert {{ flash_class }} mb-4" role="alert">{{ message|trans({}, 'messages', app.request.locale) }}</div>
                    {% endfor %}
                {% endfor %}

                <header class="mb-6">
                    <p class="mb-2 text-xs font-bold uppercase tracking-widest text-primary">Yoowii Flow</p>
                    <h1 class="break-words text-2xl font-extrabold tracking-tight text-base-content sm:text-3xl">{{ item.productName }}</h1>
                    <p class="mt-2 text-sm text-base-content/65">{{ job.reference }} · {{ 'yoowii.print_flow.quantity'|trans({'%quantity%': item.quantity}) }}</p>
                </header>

                {% if job.canAcceptCustomerArtwork %}
                    <section class="mb-6 min-w-0 rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6" data-controller="print-upload">
                        <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
                            <div class="min-w-0">
                                <h2 class="text-xl font-bold text-base-content">{{ artwork ? 'yoowii.print_flow.replace_artwork'|trans : 'yoowii.print_flow.upload_artwork'|trans }}</h2>
                                <p class="mt-1 text-sm text-base-content/65">{{ 'yoowii.print_flow.upload_formats'|trans }}</p>
                            </div>
                            <span class="badge badge-ghost">100 Mo max.</span>
                        </div>

                        {% if artwork %}
                            <div class="mb-4 flex min-w-0 flex-wrap items-center justify-between gap-3 rounded-xl border border-success/30 bg-success/10 p-4">
                                <div class="min-w-0">
                                    <strong class="block break-all text-sm text-base-content">{{ artwork.originalName }}</strong>
                                    <span class="mt-1 block text-xs text-base-content/70">{{ (artwork.size / 1024 / 1024)|number_format(2, ',', ' ') }} Mo · {{ artwork.createdAt|date('d/m/Y H:i') }}</span>
                                </div>
                                <a class="btn btn-sm btn-outline" href="{{ artwork_url }}" target="_blank" rel="noopener">{{ 'yoowii.print_flow.preview'|trans }}</a>
                            </div>

                            {% if preflight_report %}
                                {% set preflight_class = preflight_report.status.value == 'failed' ? 'border-error/40 bg-error/5' : (preflight_report.status.value == 'warning' ? 'border-warning/40 bg-warning/5' : (preflight_report.status.value == 'passed' ? 'border-success/40 bg-success/5' : 'border-info/40 bg-info/5')) %}
                                <div class="mb-5 rounded-xl border p-4 {{ preflight_class }}" role="status">
                                    <h3 class="font-bold text-base-content">Contrôle technique{% if preflight_report.status.value == 'pending' %} en cours{% elseif preflight_report.status.value == 'passed' %} validé{% elseif preflight_report.status.value == 'warning' %} à vérifier{% else %} à corriger{% endif %}.</h3>
                                    {% if preflight_report.report.checks is defined %}
                                        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
                                            {% for check in preflight_report.report.checks %}
                                                {% set check_class = check.severity == 'passed' ? 'text-success' : (check.severity == 'warning' ? 'text-warning' : 'text-error') %}
                                                <li class="{{ check_class }}">{{ check.message }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="alert alert-info mb-5" role="status"><strong>Contrôle technique en attente.</strong> Votre fichier sera analysé avant la préparation du BAT.</div>
                            {% endif %}
                        {% endif %}

                        <form action="{{ upload_url }}" method="post" enctype="multipart/form-data" data-print-upload-target="form" data-action="submit->print-upload#submit">
                            <input type="hidden" name="_token" value="{{ csrf_token('print_job_upload_' ~ job.reference) }}">
                            <label class="yoowii-print-dropzone" data-print-upload-target="dropzone" data-action="dragover->print-upload#dragover dragleave->print-upload#dragleave drop->print-upload#drop">
                                <input class="sr-only" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff,application/pdf,image/jpeg,image/png,image/tiff" required data-print-upload-target="input" data-action="change->print-upload#selected">
                                <span class="yoowii-print-dropzone-icon" aria-hidden="true">↑</span>
                                <strong class="break-all text-base-content" data-print-upload-target="label">{{ 'yoowii.print_flow.drop_file'|trans }}</strong>
                                <span class="text-sm text-base-content/65">{{ 'yoowii.print_flow.or_choose_file'|trans }}</span>
                            </label>
                            {# Legacy d-none class retained for the existing Stimulus controller; upload UX is addressed in #38. #}
                            <div class="d-none mt-3 h-6 overflow-hidden rounded-full bg-base-200" role="progressbar" aria-valuemin="0" aria-valuemax="100" data-print-upload-target="progress">
                                <div class="h-full min-w-0 rounded-full bg-primary text-center text-xs leading-6 text-primary-content" style="width: 0%" data-print-upload-target="bar">0%</div>
                            </div>
                            <div class="d-none alert alert-error mt-3" role="alert" data-print-upload-target="error"></div>
                            <label class="mt-4 flex cursor-pointer items-start gap-3 text-sm text-base-content">
                                <input class="checkbox checkbox-primary mt-0.5" type="checkbox" name="artwork_confirmation" value="1" required>
                                <span>{{ 'yoowii.print_flow.artwork_confirmation'|trans }}</span>
                            </label>
                            <button class="btn btn-primary mt-5 w-full sm:w-auto" type="submit" data-print-upload-target="submit">
                                {{ artwork ? 'yoowii.print_flow.replace_file'|trans : 'yoowii.print_flow.send_file'|trans }}
                            </button>
                        </form>
                    </section>
                {% else %}
                    <div class="alert alert-info mb-6" role="status">{{ 'yoowii.print_flow.artwork_locked'|trans }}</div>
                {% endif %}

                {% if bat %}
                    <section class="mb-6 min-w-0 rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
                        <h2 class="text-xl font-bold text-base-content">{{ 'yoowii.print_flow.bat_title'|trans }}</h2>
                        <p class="mt-2 text-sm text-base-content/65">{{ 'yoowii.print_flow.bat_hint'|trans }}</p>
                        <div class="my-5 aspect-[4/3] w-full overflow-hidden rounded-xl border border-base-300 bg-base-200">
                            {% if bat.mimeType == 'application/pdf' %}
                                <object class="h-full w-full" data="{{ bat_url }}" type="application/pdf"><a class="link link-primary" href="{{ bat_url }}" target="_blank" rel="noopener">{{ 'yoowii.print_flow.open_bat'|trans }}</a></object>
                            {% else %}
                                <img class="h-full w-full object-contain" src="{{ bat_url }}" alt="{{ 'yoowii.print_flow.bat_title'|trans }}">
                            {% endif %}
                        </div>
                        {% if job.status.value == 'bat_ready' %}
                            <form action="{{ approve_bat_url }}" method="post" class="mb-5">
                                <input type="hidden" name="_token" value="{{ csrf_token('print_job_bat_' ~ job.reference) }}">
                                <label class="mb-4 flex cursor-pointer items-start gap-3">
                                    <input class="checkbox checkbox-primary mt-0.5" type="checkbox" name="bat_confirmation" value="1" required>
                                    <span class="text-sm font-semibold text-base-content">{{ 'yoowii.print_flow.bat_confirmation'|trans }}</span>
                                </label>
                                <button class="btn btn-success" type="submit">{{ 'yoowii.print_flow.approve_bat'|trans }}</button>
                            </form>
                            <details class="border-t border-base-300 pt-4">
                                <summary class="cursor-pointer font-semibold text-error">Refuser le BAT et envoyer un fichier corrigé</summary>
                                <form action="{{ reject_bat_url }}" method="post" class="mt-4 space-y-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('print_job_bat_reject_' ~ job.reference) }}">
                                    <label class="block text-sm font-medium" for="bat-rejection-reason">Motif du refus</label>
                                    <textarea id="bat-rejection-reason" class="textarea textarea-bordered min-h-24 w-full" name="reason" rows="3" required placeholder="Indiquez précisément les corrections attendues."></textarea>
                                    <button class="btn btn-outline btn-error" type="submit">Refuser le BAT</button>
                                </form>
                            </details>
                        {% else %}
                            <span class="badge badge-success">{{ job.status.value == 'bat_approved' ? 'yoowii.print_flow.bat_already_approved'|trans : 'BAT traité' }}</span>
                        {% endif %}
                    </section>
                {% endif %}

                {% if customer_messages %}
                    <section class="mb-6 min-w-0 rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
                        <h2 class="text-lg font-bold">Vos messages</h2>
                        <div class="mt-3 divide-y divide-base-300">
                            {% for message in customer_messages %}
                                <div class="py-4">
                                    <h3 class="font-semibold">{{ message.type == 'bat_rejected' ? 'Refus du BAT' : (message.type == 'preflight_correction_requested' ? 'Fichier à corriger' : 'Message') }}</h3>
                                    <div class="mt-2 whitespace-pre-wrap break-words text-sm">{{ message.message }}</div>
                                    <time class="mt-2 block text-xs text-base-content/60" datetime="{{ message.createdAt|date('c') }}">{{ message.createdAt|date('d/m/Y H:i') }}</time>
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            </main>

            <aside class="min-w-0 lg:sticky lg:top-6" aria-label="{{ 'yoowii.print_flow.follow_up'|trans }}">
                <section class="yoowii-print-flow-summary rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-lg font-bold">{{ 'yoowii.print_flow.follow_up'|trans }}</h2>
                    <span class="yoowii-print-status is-{{ job.status.value }} mb-5">{{ ('yoowii.print_flow.status.' ~ job.status.value)|trans }}</span>
                    <ol class="yoowii-print-timeline m-0 list-none p-0">
                        {% for step in steps %}
                            <li class="{{ current_step >= loop.index0 ? 'is-complete' : '' }}{{ current_step == loop.index0 ? ' is-current' : '' }}">
                                <span aria-hidden="true"></span>
                                {{ ('yoowii.print_flow.status.' ~ step)|trans }}
                            </li>
                        {% endfor %}
                    </ol>
                    {% if job.trackingNumber %}
                        <div class="mt-4 border-t border-base-300 pt-4">
                            <strong class="block text-sm">{{ 'yoowii.print_flow.tracking'|trans }}</strong>
                            {% if job.trackingUrl %}
                                <a class="link link-primary mt-2 block break-all text-sm" href="{{ job.trackingUrl }}" target="_blank" rel="noopener">{{ job.trackingNumber }}</a>
                            {% else %}
                                <span class="mt-2 block break-all text-sm">{{ job.trackingNumber }}</span>
                            {% endif %}
                        </div>
                    {% endif %}
                </section>
            </aside>
        </div>
    </div>
{% endblock %}
