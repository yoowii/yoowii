{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'yoowii.print_flow.my_print_files'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="yoowii-print-flow mx-auto my-8 w-full max-w-7xl px-4 sm:px-6 lg:my-12 lg:px-8">
        <div class="mx-auto max-w-5xl">
            <header class="mb-6">
                <p class="mb-2 text-xs font-bold uppercase tracking-widest text-primary">Yoowii Flow</p>
                <h1 class="break-words text-2xl font-extrabold tracking-tight text-base-content sm:text-3xl">{{ 'yoowii.print_flow.my_print_files'|trans }}</h1>
                <p class="mt-2 text-base text-base-content/65">{{ 'yoowii.print_flow.order_hint'|trans({'%number%': order.number}) }}</p>
            </header>
            <div class="grid min-w-0 gap-4 md:grid-cols-2">
                {% for job in jobs %}
                    {% set item = job.orderItem %}
                    <article class="flex min-w-0 flex-col rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm sm:p-6">
                        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-base-content/60">{{ job.reference }}</p>
                        <h2 class="break-words text-lg font-bold text-base-content">{{ item.productName }}</h2>
                        <p class="mt-1 text-sm text-base-content/65">{{ 'yoowii.print_flow.quantity'|trans({'%quantity%': item.quantity}) }}</p>
                        <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
                            <span class="yoowii-print-status is-{{ job.status.value }}">{{ ('yoowii.print_flow.status.' ~ job.status.value)|trans }}</span>
                            <a class="btn btn-primary" href="{{ job_links[job.reference] }}">{{ 'yoowii.print_flow.manage_files'|trans }}</a>
                        </div>
                    </article>
                {% else %}
                    <div class="rounded-2xl border border-base-300 bg-base-100 p-8 text-center text-base-content/70 md:col-span-2" role="status">{{ 'yoowii.print_flow.no_jobs'|trans }}</div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
