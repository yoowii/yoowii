{% macro groups(taxon) %}
    {% set level2_taxons = advanced_taxon_ordered_children(taxon) %}
    <div class="min-w-0">
        <div class="flex items-start justify-between gap-4 border-b border-base-300 pb-4">
            <p class="font-display text-xl font-extrabold text-base-content">{{ taxon.name }}</p>
            <a class="shrink-0 text-sm font-bold text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.translation.locale}) }}">{{ 'yoowii.storefront.mega_menu.view_all_category'|trans }} <span aria-hidden="true">→</span></a>
        </div>
        {% if level2_taxons is empty %}
            <p class="mt-5 text-sm text-base-content/70">{{ 'yoowii.storefront.mega_menu.empty_family'|trans }}</p>
        {% else %}
            <ul class="mt-5 grid gap-x-8 gap-y-6 md:grid-cols-2 xl:grid-cols-3">
                {% for group_taxon in level2_taxons %}
                    {% set level3_taxons = advanced_taxon_ordered_children(group_taxon) %}
                    {% set products = yoowii_mega_menu_products(group_taxon) %}
                    {% set groupMedia = group_taxon.images|filter(image => image.path|default('') is not empty)|first %}
                    <li class="min-w-0">
                        <a class="group flex items-center gap-3 rounded-btn focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': group_taxon.slug, '_locale': group_taxon.translation.locale}) }}">
                            <span class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-btn border border-base-300 bg-base-200 text-primary">
                                {% if groupMedia %}<img class="size-full object-cover" src="{{ advanced_taxon_media_url(groupMedia.path) }}" alt="" loading="lazy">
                                {% elseif group_taxon.showCustomizationInMenu|default(false) and group_taxon.icon|default(null) is not empty and not (group_taxon.icon starts with 'image:') %}{{ ux_icon(':' in group_taxon.icon ? group_taxon.icon : 'tabler:' ~ group_taxon.icon, {class: 'size-6', 'aria-hidden': 'true'}) }}
                                {% else %}<svg class="size-6" aria-hidden="true"><use href="{{ asset('themes/yoowii-theme/media/mega-menu-icons.svg') }}#category"></use></svg>{% endif %}
                            </span>
                            <span class="font-display text-base font-extrabold text-base-content group-hover:text-primary">{{ group_taxon.name }}</span>
                        </a>
                        {% if products is not empty %}<ul class="mt-3 space-y-1.5 pl-[3.75rem] text-sm text-base-content/70">{% for product in products %}<li><a class="hover:text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': app.request.locale}) }}">{{ product.name }}</a></li>{% endfor %}</ul>{% endif %}
                        {% if level3_taxons is not empty %}<ul class="mt-3 space-y-1.5 pl-[3.75rem] text-sm text-base-content/70">{% for level3_taxon in level3_taxons %}<li><a class="hover:text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="{{ path('sylius_shop_product_index', {'slug': level3_taxon.slug, '_locale': level3_taxon.translation.locale}) }}">{{ level3_taxon.name }}</a></li>{% endfor %}</ul>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endmacro %}
