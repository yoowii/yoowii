{% set product = variant.product %}
{% set is_print = product.fulfillmentType.value == 'print' %}

{% if has_discount %}
    <span class="text-sm text-base-content/50" {{ sylius_test_html_attribute('product-original-price') }}><del>{{ original_price }}</del></span>
{% endif %}
<span class="font-semibold text-base-content" {{ sylius_test_html_attribute('product-price') }}>
    {% if is_print %}<span class="mr-1 text-xs font-medium text-base-content/60">{{ 'yoowii.storefront.starting_from'|trans }}</span>{% endif %}{{ price }}
</span>
