{% set has_print = false %}
{% for item in order.items %}
    {% if item.variant and item.variant.product and item.variant.product.fulfillmentType and item.variant.product.fulfillmentType.value == 'print' %}
        {% set has_print = true %}
    {% endif %}
{% endfor %}

{% if has_print and order.paymentState == 'paid' %}
    <section class="my-5 flex min-w-0 flex-col gap-4 rounded-2xl border border-primary/20 bg-base-200 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div class="min-w-0">
            <h2 class="font-bold text-base-content">{{ 'yoowii.print_flow.thank_you_title'|trans }}</h2>
            <p class="mt-1 text-sm text-base-content/70">{{ 'yoowii.print_flow.thank_you_hint'|trans }}</p>
        </div>
        <a class="btn btn-primary shrink-0" href="{{ path('yoowii_shop_flow_order_print_files', {_locale: app.request.locale, tokenValue: order.tokenValue}) }}">
            {{ 'yoowii.print_flow.upload_my_files'|trans }}
        </a>
    </section>
{% endif %}
