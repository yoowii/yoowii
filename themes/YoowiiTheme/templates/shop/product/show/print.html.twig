{% from '@SyliusShop/product/common/macro/breadcrumbs.html.twig' import product_breadcrumbs %}

{% set main_image = product.images.first %}
{% if main_image %}
    {% set main_source = main_image.path %}
    {% set main_path = main_source|imagine_filter('sylius_shop_product_large_thumbnail') %}
    {% set main_original_path = main_source|imagine_filter('sylius_shop_product_original') %}
{% else %}
    {% set main_path = asset('build/shop/images/400x300.png', 'shop') %}
    {% set main_original_path = main_path %}
{% endif %}

<main class="yoowii-print-product-page yoowii-container mb-14 mt-6" data-product-experience="print">
    <div class="mb-5 text-sm text-base-content/70">
        {{ product_breadcrumbs(product) }}
    </div>

    <header class="mb-8 max-w-4xl">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">Yoowii Print</p>
        <h1 class="font-display text-3xl font-bold tracking-tight text-base-content sm:text-4xl">{{ product.name }}</h1>
        {% if product.shortDescription %}
            <div class="mt-3 max-w-3xl leading-relaxed text-base-content/75">{{ product.shortDescription }}</div>
        {% endif %}
    </header>

    <div class="grid items-start gap-8 xl:grid-cols-[minmax(20rem,0.72fr)_minmax(0,1.28fr)] xl:gap-12">
        <aside class="min-w-0 xl:sticky xl:top-6">
            <div class="rounded-box border border-base-300 bg-base-200/60 p-3 sm:p-5">
                <a href="{{ main_original_path }}" class="block aspect-square overflow-hidden rounded-box bg-base-100">
                    <img
                        src="{{ main_path }}"
                        alt="{{ product.name }}"
                        class="h-full w-full object-contain"
                        {% if main_image %}{{ sylius_test_html_attribute('main-image', main_image.type) }}{% else %}{{ sylius_test_html_attribute('main-image') }}{% endif %}
                    >
                </a>

                {% if product.images|length > 1 %}
                    <ul class="mt-4 flex gap-3 overflow-x-auto pb-1" aria-label="{{ 'sylius.ui.product'|trans }}">
                        {% for image in product.images %}
                            {% set image_path = image.path is not null ? image.path|imagine_filter('sylius_shop_product_small_thumbnail') : asset('build/shop/images/200x200.png', 'shop') %}
                            {% set image_original_path = image.path is not null ? image.path|imagine_filter('sylius_shop_product_original') : image_path %}
                            <li class="w-20 shrink-0">
                                <a href="{{ image_original_path }}" class="block aspect-square overflow-hidden rounded-box border border-base-300 bg-base-100 p-1 focus:outline-none focus:ring-2 focus:ring-primary">
                                    <img src="{{ image_path }}" alt="{{ product.name }}" class="h-full w-full object-contain">
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            <div
                class="mt-5 rounded-box border border-base-300 bg-base-100 p-5"
                data-controller="configuration-summary"
                data-configuration-summary-context-value="{{ configuration_context }}"
                aria-live="polite"
            >
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h2 class="font-display text-base font-semibold text-base-content">Votre configuration</h2>
                        <p class="mt-1 text-sm text-base-content/70" data-configuration-summary-target="progress">0 choix sur 0 effectués</p>
                    </div>
                    <button class="btn btn-ghost btn-xs" type="button" data-action="configuration-summary#reset">Restaurer</button>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-base-content/70" data-configuration-summary-target="empty">Choisissez les caractéristiques du produit pour afficher votre récapitulatif.</p>
                <ul class="yoowii-print-summary-list mt-3" data-configuration-summary-target="list"></ul>
            </div>
        </aside>

        <section id="yoowii-print-configurator" class="min-w-0" aria-label="Configuration du produit">
            {{ render(controller(
                'App\\Yoowii\\Pricing\\UI\\Http\\Storefront\\Controller\\PrintProductConfiguratorController::component',
                {
                    productCode: product.code,
                    quoteToken: quote_token,
                    embeddedProductPage: true,
                    configurationContext: configuration_context
                }
            )) }}
        </section>
    </div>

    <section class="mt-12 border-t border-base-300 pt-8">
        {% hook 'sylius_shop.product.show.content.product_listing' with { product } %}
    </section>
</main>
