{% from '@SyliusShop/product/common/macro/breadcrumbs.html.twig' import product_breadcrumbs %}

{% set main_image = product.images.first %}
{% if main_image %}
    {% set main_source = main_image.path %}
    {% set main_path = main_source|imagine_filter('sylius_shop_product_large_thumbnail') %}
    {% set main_original_path = main_source|imagine_filter('sylius_shop_product_original') %}
{% else %}
    {% set main_path = asset('build/shop/images/400x300.png', 'shop') %}
    {% set main_original_path = main_path %}
{% endif %}

<main
    class="yoowii-print-product-page yoowii-container mb-14 mt-6 pb-24 xl:pb-0"
    data-controller="configuration-summary"
    data-configuration-summary-context-value="{{ configuration_context }}"
    data-product-experience="print"
>
    <div class="mb-5 text-sm text-base-content/70">
        {{ product_breadcrumbs(product) }}
    </div>

    <div class="grid items-start gap-8 xl:grid-cols-[minmax(20rem,0.72fr)_minmax(0,1.28fr)] xl:gap-12">
        <aside class="min-w-0 xl:sticky xl:top-6">
            <div
                class="yoowii-prescript-gallery-slot yoowii-product-gallery"
                data-prescript-gallery-slot
                data-controller="yoowii-gallery"
                data-yoowii-gallery-context-value="{{ configuration_context }}"
                data-action="yoowii:prescript-gallery-update@document->yoowii-gallery#update"
            >
                <div class="yoowii-product-gallery__stage">
                    <img
                        src="{{ main_path }}"
                        alt="{{ product.name }}"
                        class="yoowii-product-gallery__image"
                        data-yoowii-gallery-target="image"
                        {% if main_image %}{{ sylius_test_html_attribute('main-image', main_image.type) }}{% else %}{{ sylius_test_html_attribute('main-image') }}{% endif %}
                    >
                    <button class="yoowii-product-gallery__control" type="button" aria-label="Visuel précédent" hidden data-action="yoowii-gallery#previous" data-yoowii-gallery-target="previous">‹</button>
                    <button class="yoowii-product-gallery__control" type="button" aria-label="Visuel suivant" hidden data-action="yoowii-gallery#next" data-yoowii-gallery-target="next">›</button>
                </div>
                <div class="yoowii-product-gallery__thumbnails" aria-label="{{ 'sylius.ui.product'|trans }}" data-yoowii-gallery-target="thumbnails">
                    {% for image in product.images %}
                        {% set image_path = image.path is not null ? image.path|imagine_filter('sylius_shop_product_small_thumbnail') : asset('build/shop/images/200x200.png', 'shop') %}
                        {% set image_original_path = image.path is not null ? image.path|imagine_filter('sylius_shop_product_original') : image_path %}
                        <button
                            class="yoowii-product-gallery__thumbnail"
                            type="button"
                            data-gallery-image="{{ image_original_path }}"
                            data-gallery-thumbnail="{{ image_path }}"
                            data-gallery-alt="{{ product.name }}"
                        ><img src="{{ image_path }}" alt="" loading="lazy"></button>
                    {% endfor %}
                </div>
            </div>

            <div
                class="mt-5 hidden rounded-box border border-base-300 bg-base-100 p-5 xl:block"
                aria-live="polite"
            >
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h2 class="font-display text-base font-semibold text-base-content">Votre configuration</h2>
                        <p class="mt-1 text-sm text-base-content/70" data-configuration-summary-target="progress">0 choix sur 0 effectués</p>
                    </div>
                    <button class="btn btn-ghost btn-xs" type="button" data-action="configuration-summary#reset">Restaurer</button>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-base-content/70" data-configuration-summary-target="empty">Choisissez les caractéristiques du produit pour afficher votre récapitulatif.</p>
                <ul class="yoowii-print-summary-list mt-3" data-configuration-summary-target="list"></ul>
            </div>
        </aside>

        <section id="yoowii-print-configurator" class="min-w-0" aria-label="Configuration du produit">
            {{ render(controller(
                'App\\Yoowii\\Pricing\\UI\\Http\\Storefront\\Controller\\PrintProductConfiguratorController::component',
                {
                    productCode: product.code,
                    quoteToken: quote_token,
                    embeddedProductPage: true,
                    configurationContext: configuration_context
                }
            )) }}
        </section>
    </div>

    <section class="mt-12 border-t border-base-300 pt-8">
        <div class="mb-8 w-full">
            {% hook 'sylius_shop.product.show.content.info.overview.accordion' with { product, configuration } %}
        </div>
        {% hook 'sylius_shop.product.show.content.product_listing' with { product } %}
    </section>

    <div class="fixed inset-x-0 bottom-0 z-30 border-t border-base-300 bg-base-100/95 p-3 shadow-[0_-8px_24px_rgb(30_27_58/0.12)] backdrop-blur xl:hidden">
        <div class="yoowii-container flex items-center justify-between gap-3 px-0">
            <p class="min-w-0 truncate text-sm font-semibold text-base-content" data-configuration-summary-target="progress">0 choix sur 0 effectués</p>
            <button class="btn btn-primary btn-sm shrink-0" type="button" data-action="configuration-summary#open">Voir le détail</button>
        </div>
    </div>

    <dialog class="modal modal-bottom sm:modal-middle" aria-labelledby="yoowii-mobile-summary-title" data-configuration-summary-target="dialog">
        <div class="modal-box max-h-[80vh] overflow-y-auto">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 id="yoowii-mobile-summary-title" class="font-display text-lg font-semibold text-base-content">Votre configuration</h2>
                    <p class="mt-1 text-sm text-base-content/70" data-configuration-summary-target="progress">0 choix sur 0 effectués</p>
                </div>
                <button class="btn btn-ghost btn-sm btn-square" type="button" aria-label="Fermer le résumé" data-action="configuration-summary#close">×</button>
            </div>
            <p class="mt-5 text-sm leading-relaxed text-base-content/70" data-configuration-summary-target="empty">Choisissez les caractéristiques du produit pour afficher votre récapitulatif.</p>
            <ul class="yoowii-print-summary-list mt-3" data-configuration-summary-target="list"></ul>
            <div class="mt-5 border-t border-base-300 pt-4">
                <button class="btn btn-ghost btn-sm" type="button" data-action="configuration-summary#reset">Restaurer les choix</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop"><button aria-label="Fermer le résumé">Fermer</button></form>
    </dialog>
</main>
