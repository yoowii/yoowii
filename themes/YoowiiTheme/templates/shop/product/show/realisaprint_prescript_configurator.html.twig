<section
    class="yoowii-prescript-shell card border-base-300 bg-base-100 shadow-sm"
    data-controller="realisaprint-prescript-quote"
    data-realisaprint-prescript-quote-cart-url-value="{{ path('yoowii_shop_realisaprint_prescript_add_to_cart', {productCode: product.code, _locale: app.request.locale}) }}"
    data-realisaprint-prescript-quote-cart-summary-url-value="{{ path('sylius_shop_cart_summary', {_locale: app.request.locale}) }}"
    data-realisaprint-prescript-quote-csrf-token-value="{{ csrf_token('prescript_quote_' ~ product.code) }}"
    data-realisaprint-prescript-quote-summary-context-value="{{ configuration_context|default('print-' ~ product.code) }}"
    {% if prescript_summary_profile is not null %}
        data-realisaprint-prescript-quote-summary-profile-value="{{ prescript_summary_profile|json_encode|e('html_attr') }}"
    {% endif %}
>
    <div class="card-body gap-6 p-4 sm:p-6 lg:p-8">
        <header class="max-w-2xl">
            <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">Yoowii Print</p>
            <h2 class="text-2xl font-bold text-base-content sm:text-3xl">{{ 'yoowii.storefront.print_configuration'|trans }}</h2>
            <p class="mt-2 text-base-content/70">Configurez votre produit, puis enregistrez la configuration afin de poursuivre la commande.</p>
        </header>

        <div
            class="yoowii-prescript-status alert alert-info"
            role="status"
            aria-live="polite"
            data-realisaprint-prescript-quote-target="status"
        >
            <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
            <span>Chargement du configurateur…</span>
        </div>

        <div class="yoowii-prescript-options" data-realisaprint-prescript-quote-target="options"></div>

        <button class="btn btn-primary btn-lg w-full sm:w-auto" type="button" data-action="realisaprint-prescript-quote#calculateSupplierPrice" data-realisaprint-prescript-quote-target="supplierCalculate">
            {{ 'yoowii.storefront.calculate_price'|trans }}
        </button>

        <div class="yoowii-prescript-pricing" data-realisaprint-prescript-quote-target="pricing"></div>
        <div class="yoowii-prescript-purchase-summary rounded-box border border-base-300 bg-base-200 p-4" data-realisaprint-prescript-quote-target="purchaseSummary" aria-live="polite" hidden>
            <h3 class="mb-3 font-semibold text-base-content">Votre sélection</h3>
            <div class="grid grid-cols-2 gap-3 text-sm">
                <span>Quantité</span><strong class="text-right"><span data-purchase-quantity></span> exemplaires</strong>
                <span>Fabrication</span><strong class="text-right" data-purchase-delivery></strong>
                <span data-purchase-delay-label>Délai</span><strong class="text-right" data-purchase-delay></strong>
                <span data-purchase-delivery-date-label hidden>Livraison prévue</span><strong class="text-right" data-purchase-delivery-date hidden></strong>
                <span data-purchase-weight-label hidden>Poids</span><strong class="text-right" data-purchase-weight hidden></strong>
                <span class="col-span-2 text-success" data-purchase-shipping-included hidden></span>
            </div>
            <div class="mt-3 flex items-center justify-between border-t border-base-300 pt-3">
                <span class="font-medium">Prix de la configuration</span>
                <strong class="text-xl text-primary" data-purchase-price></strong>
            </div>
        </div>

        <button class="btn btn-success btn-lg hidden w-full sm:w-auto" type="button" data-action="realisaprint-prescript-quote#prepareCart" data-realisaprint-prescript-quote-target="addToCart">
            {{ 'yoowii.storefront.add_to_cart'|trans }}
        </button>

        <div
            id="api_prescript_wrapper"
            class="yoowii-prescript-embed yoowii-prescript-source"
            data-prescript-product-code="{{ product.code }}"
            data-realisaprint-prescript-quote-target="embed"
        >
            {{ prescript_template|raw }}
        </div>

        <div class="alert alert-error hidden" role="alert" data-realisaprint-prescript-quote-target="error"></div>
        <a
            class="btn btn-outline btn-primary mt-3 hidden"
            href="{{ path('sylius_shop_contact_request', {_locale: app.request.locale}) }}"
            data-realisaprint-prescript-quote-target="quoteRequest"
        >
            Demander un devis personnalisé
        </a>

        <p class="hidden text-sm font-medium text-warning" role="status" aria-live="polite" data-realisaprint-prescript-quote-target="quoteStale">
            Votre configuration a changé. Recalculez le prix avant d’ajouter le produit au panier.
        </p>

        <div class="alert alert-info hidden" role="status" aria-live="polite" data-realisaprint-prescript-quote-target="loading">
            <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
            <span>{{ 'yoowii.storefront.calculating_price'|trans }}</span>
        </div>

        <div class="yoowii-prescript-quote border-t border-base-300 pt-5" data-realisaprint-prescript-quote-target="quoteResult">
            <p class="text-base-content/70" data-empty-quote>{{ 'yoowii.storefront.price_after_configuration'|trans }}</p>
        </div>
    </div>
</section>
