{% form_theme form '@SyliusShop/form/theme.html.twig' %}

{% set configurable_fields = [] %}
{% for field in form %}
    {% if field.vars.name != '_token' %}
        {% set configurable_fields = configurable_fields|merge([field]) %}
    {% endif %}
{% endfor %}
{% set initial_visibility = initial_provider_state.visibility|default({}) %}
{% set initial_availability = initial_provider_state.availability|default({}) %}

<div
    class="yoowii-print-configurator mx-auto max-w-7xl py-8 sm:py-12"
    data-controller="print-configurator"
    data-print-configurator-refresh-url-value="{{ refresh_url|default('') }}"
    data-print-configurator-has-quote-value="{{ stored_quote and quote_token ? 'true' : 'false' }}"
    data-empty-quote-label="{{ 'yoowii.storefront.price_after_configuration'|trans }}"
    data-print-configurator-pricing-axes-value="{{ pricing_axes|default([])|json_encode|e('html_attr') }}"
    data-print-configurator-summary-context-value="{{ configuration_context|default('print-' ~ product.code) }}"
    data-print-configurator-debug-value="{{ app.environment == 'dev' ? 'true' : 'false' }}"
    {% if initial_provider_state is not null %}
        data-print-configurator-initial-provider-state-value="{{ initial_provider_state|json_encode|e('html_attr') }}"
    {% endif %}
    data-print-configurator-initial-provider-state-stale-value="{{ initial_provider_state_stale|default(false) ? 'true' : 'false' }}"
>
    <header class="mb-8 max-w-2xl">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">Yoowii Print</p>
        <h2 class="text-2xl font-bold text-base-content sm:text-3xl">{{ 'yoowii.storefront.print_configuration'|trans }}</h2>
        <p class="mt-2 text-base-content/70">{{ 'yoowii.storefront.print_configuration_hint'|trans }}</p>
    </header>

    {% if available %}
        <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] xl:grid-cols-[minmax(0,1fr)_26rem]">
            <div class="min-w-0">
                <div
                    class="alert alert-error d-none"
                    role="alert"
                    data-print-configurator-target="error"
                ></div>

                {{ form_start(form, {
                    attr: {
                        class: 'yoowii-print-options space-y-3',
                        'data-print-configurator-target': 'form',
                        'data-action': 'submit->print-configurator#submit'
                    }
                }) }}
                {{ form_errors(form) }}

                {% for code, fixed in fixed_fields|default([]) %}
                    <p class="rounded-box bg-base-200 px-3 py-2 text-sm text-base-content/70" data-fixed-axis="{{ code }}">
                        <strong>{{ code|replace({'_': ' '})|capitalize }} :</strong> {{ fixed.label }} · valeur imposée par Realisaprint
                    </p>
                {% endfor %}
                {% set previous_steps_complete = true %}
                {% set secondary_started = false %}
                <h3 class="mb-3 text-lg font-semibold text-base-content">Caractéristiques</h3>
                {% for field in configurable_fields %}
                    {% set option_code = field.vars.name %}
                    {% if field.vars.attr['data-area']|default(1) == 2 and not secondary_started %}
                        {% set secondary_started = true %}
                        <h3 class="mb-3 mt-8 text-lg font-semibold text-base-content">Options complémentaires</h3>
                    {% endif %}
                    {% set step_index = loop.index0 %}
                    {% set initially_visible = initial_visibility[option_code] is defined ? initial_visibility[option_code] : true %}
                    {% set initially_available_values = initial_availability[option_code] is defined ? initial_availability[option_code] : null %}
                    {% set selected_label = null %}
                    {% for choice in field %}
                        {% if choice.vars.checked %}
                            {% set selected_label = choice.vars.label %}
                        {% endif %}
                    {% endfor %}
                    {% if selected_label is null and field.vars.value is not empty %}{% set selected_label = field.vars.value %}{% endif %}
                    {% set step_complete = selected_label is not null %}
                    {% set step_enabled = previous_steps_complete %}

                    <details
                        id="yoowii-print-step-{{ field.vars.name }}"
                        class="yoowii-print-step{{ step_complete ? ' is-complete' : '' }}{{ not step_enabled ? ' is-disabled' : '' }}{{ not initially_visible ? ' d-none' : '' }}"
                        data-print-configurator-target="step option"
                        data-step-index="{{ step_index }}"
                        data-option-code="{{ field.vars.name }}"
                        data-area="{{ field.vars.attr['data-area']|default(1) }}"
                        data-depends-on="{{ field.vars.attr['data-depends-on']|default('') }}"
                        aria-hidden="{{ initially_visible ? 'false' : 'true' }}"
                        {% if step_enabled and not step_complete %}open{% endif %}
                    >
                        <summary data-action="click->print-configurator#guardStep">
                            <span class="yoowii-print-step-status" aria-hidden="true">
                                <span class="yoowii-print-step-number">{{ loop.index }}</span>
                                <span class="yoowii-print-step-check">✓</span>
                            </span>
                            <span class="font-semibold">{{ field.vars.label }}</span>
                            <span class="yoowii-print-step-value" data-role="step-value">
                                {{ selected_label ?? 'yoowii.storefront.choice_pending'|trans }}
                            </span>
                            <span class="yoowii-print-step-chevron" aria-hidden="true"></span>
                        </summary>

                        <div class="yoowii-print-step-content">
                            {{ form_errors(field) }}
                            {% if field|length > 0 %}<div class="yoowii-print-choice-grid{{ field.vars.name == 'format' ? ' is-format-grid' : '' }}">
                                {% for choice in field %}
                                    {% set initially_available = initially_available_values is null or choice.vars.value in initially_available_values %}
                                    <div class="yoowii-print-choice{{ not initially_available ? ' d-none' : '' }}">
                                        <label class="yoowii-print-choice-card" for="{{ choice.vars.id }}">
                                            {{ form_widget(choice, {
                                                label: false,
                                                disabled: not initially_visible,
                                                attr: {
                                                    class: 'btn-check',
                                                    autocomplete: 'off',
                                                    'data-action': 'change->print-configurator#change',
                                                    'data-choice-label': choice.vars.label
                                                }
                                            }) }}
                                            {% if field.vars.name == 'format' %}
                                                <span class="yoowii-print-format-preview" aria-hidden="true">
                                                    <span>{{ choice.vars.value }}</span>
                                                </span>
                                            {% endif %}
                                            <span class="yoowii-print-choice-label">{{ choice.vars.label }}</span>
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                            {% else %}
                                {% set live_input = 'integer' in field.vars.block_prefixes or 'number' in field.vars.block_prefixes or 'text' in field.vars.block_prefixes %}
                                {{ form_widget(field, {disabled: not initially_visible, attr: {'data-action': live_input ? 'input->print-configurator#input' : 'change->print-configurator#change'}}) }}
                            {% endif %}
                        </div>
                    </details>

                    {% if not step_complete %}
                        {% set previous_steps_complete = false %}
                    {% endif %}
                {% endfor %}

                {{ form_rest(form) }}
                <noscript>
                    <button class="btn btn-primary btn-lg mt-4" type="submit">
                        {{ 'yoowii.storefront.calculate_price'|trans }}
                    </button>
                </noscript>
                <button class="btn btn-primary btn-lg mt-4" type="button" data-action="print-configurator#calculate">
                    {{ 'yoowii.storefront.calculate_price'|trans }}
                </button>
                {{ form_end(form, {render_rest: false}) }}

                {% if embedded_product_page|default(false) %}
                    <div
                        class="yoowii-print-calculating alert alert-info d-none mt-4"
                        role="status"
                        aria-live="polite"
                        data-print-configurator-target="loading"
                    >
                        <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
                        <span>{{ 'yoowii.storefront.calculating_price'|trans }}</span>
                    </div>

                    <div class="mt-4" data-print-configurator-target="quoteResult">
                        {% include 'shop/product/show/_print_quote.html.twig' with {
                            pricing_snapshot: stored_quote ? stored_quote.pricingSnapshot : null,
                            quote_token: quote_token
                        } only %}
                    </div>
                {% endif %}
            </div>

            <div class="{{ embedded_product_page|default(false) ? 'hidden' : '' }}">
                <aside class="card border border-base-300 bg-base-100 shadow-sm yoowii-print-summary">
                    <div class="card-body gap-4 p-5">
                        <div class="flex items-center justify-between gap-3">
                            <h3 class="text-lg font-semibold text-base-content">{{ 'yoowii.storefront.print_summary'|trans }}</h3>
                            <button
                                class="btn btn-ghost btn-sm"
                                type="button"
                                data-action="print-configurator#reset"
                            >
                                {{ 'yoowii.storefront.restore_choices'|trans }}
                            </button>
                        </div>

                        <ul class="yoowii-print-summary-list">
                            {% for field in configurable_fields %}
                                {% set option_code = field.vars.name %}
                                {% set selected_label = null %}
                                {% for choice in field %}
                                    {% if choice.vars.checked %}
                                        {% set selected_label = choice.vars.label %}
                                    {% endif %}
                                {% endfor %}
                                <li
                                    class="{{ selected_label is not null ? 'is-complete' : 'is-pending' }}{{ initial_visibility[option_code] is defined and not initial_visibility[option_code] ? ' d-none' : '' }}"
                                    data-print-configurator-target="summaryItem"
                                    data-step-index="{{ loop.index0 }}"
                                    data-option-code="{{ option_code }}"
                                    data-pending-label="{{ 'yoowii.storefront.choice_pending'|trans }}"
                                    aria-hidden="{{ initial_visibility[option_code] is defined and not initial_visibility[option_code] ? 'true' : 'false' }}"
                                >
                                    <span class="yoowii-print-summary-check" aria-hidden="true">✓</span>
                                    <span class="yoowii-print-summary-name">{{ field.vars.label }}</span>
                                    <strong data-role="summary-value">
                                        {{ selected_label ?? 'yoowii.storefront.choice_pending'|trans }}
                                    </strong>
                                    <button
                                        class="btn btn-ghost btn-xs"
                                        type="button"
                                        data-action="print-configurator#openStep"
                                        data-step-index="{{ loop.index0 }}"
                                    >
                                        {{ 'yoowii.storefront.change_choice'|trans }}
                                    </button>
                                </li>
                            {% endfor %}
                        </ul>

                        {% if not embedded_product_page|default(false) %}
                            <div
                                class="yoowii-print-calculating alert alert-info d-none"
                                role="status"
                                aria-live="polite"
                                data-print-configurator-target="loading"
                            >
                                <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
                                <span>{{ 'yoowii.storefront.calculating_price'|trans }}</span>
                            </div>

                            <div data-print-configurator-target="quoteResult">
                                {% include 'shop/product/show/_print_quote.html.twig' with {
                                    pricing_snapshot: stored_quote ? stored_quote.pricingSnapshot : null,
                                    quote_token: quote_token
                                } only %}
                            </div>
                        {% endif %}
                    </div>
                </aside>
            </div>
        </div>
    {% else %}
        <div class="alert alert-warning" role="alert">
            {{ 'yoowii.storefront.configuration_unavailable'|trans }}
        </div>
    {% endif %}
</div>
